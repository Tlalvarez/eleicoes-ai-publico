---
/**
 * A conversa só sobre UM candidato a governador, senador ou deputado federal:
 * o mesmo chat, com o nome do candidato e o cargo/UF na frente de cada
 * pergunta, à vista. Uma página por candidatura do snapshot do TSE.
 */
import Base from '../../../layouts/Base.astro';
import Chat from '../../../components/Chat.astro';
import { CARGOS_POR_UF, UFS, caminhoUf, rotuloEscopo } from '../../../lib/cargos.mjs';
import { candidaturas } from '../../../lib/candidaturas-uf.mjs';

export function getStaticPaths() {
  return CARGOS_POR_UF.flatMap((cargo) => UFS.flatMap((uf) =>
    candidaturas(cargo.slug, uf.sigla).map((c) => ({
      params: { cargo: cargo.slug, uf: uf.sigla.toLowerCase(), slug: c.slug },
      props: { cargo, uf, c },
    }))));
}
const { cargo, uf, c } = Astro.props;
const rotulo = rotuloEscopo(cargo, uf);
const escopo = `${c.nome} (${rotulo})`;
const pagina = `${caminhoUf(cargo, uf)}/${c.slug}`;

// o mesmo critério da home (ver index.astro): sem PUBLIC_PESQUISA_API, mesma
// origem; localhost só em desenvolvimento
const apiBase = import.meta.env.PUBLIC_PESQUISA_API
  ?? (import.meta.env.DEV ? 'http://localhost:8765' : '');
---
<Base title={`${c.nome} — ${rotulo}`} description={`Converse com as evidências reunidas sobre ${c.nome}, candidatura a ${cargo.nome.toLowerCase()} — ${uf.nome} — em 2026.`}>
  <div class="hero-home">
    <p class="sobretitulo">Eleições gerais de 2026 · {cargo.nome} · {uf.sigla}</p>
    <div class="cabecalho-candidato">
      <img class="retrato" src={c.foto} width="92" height="128" alt="" />
      <div>
        <h1>{c.nome}</h1>
        <p class="lead">
          {rotulo} · {c.partido ?? '—'}{c.numero ? ` · nº ${c.numero}` : ''} · {c.situacao}
        </p>
        <p class="links-candidato">
          <a href={c.tse} target="_blank" rel="noopener noreferrer">Candidatura no TSE ↗</a>
          <a href={caminhoUf(cargo, uf)}>Todos os candidatos a {cargo.nome.toLowerCase()} — {uf.nome}</a>
        </p>
      </div>
    </div>
  </div>

  <Chat apiBase={apiBase} escopo={escopo} pagina={pagina}
    placeholder={`Ex.: o que ${c.nome} propõe para a educação?`} />

  <style>
    .hero-home { margin-bottom: 1.6rem; }
    .hero-home .lead { max-width: none; margin-bottom: .4rem; }
    .sobretitulo {
      margin: 0 0 .6rem;
      color: var(--acento);
      font-size: .79rem;
      font-weight: 800;
      letter-spacing: .13em;
      text-transform: uppercase;
    }
    .cabecalho-candidato { display: flex; gap: 1.1rem; align-items: flex-start; }
    .cabecalho-candidato h1 { margin-top: 0; }
    .retrato {
      flex: 0 0 92px;
      width: 92px;
      height: 128px;
      object-fit: cover;
      border-radius: var(--raio);
      border: 1px solid var(--linha);
      background: var(--realce);
    }
    .links-candidato { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; margin: 0; font-size: .92rem; }
    .links-candidato a { color: var(--acento); font-weight: 600; }
    @media (max-width: 520px) {
      .cabecalho-candidato { flex-direction: column; }
    }
  </style>
</Base>
