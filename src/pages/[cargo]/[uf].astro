---
/**
 * Um cargo numa UF: os temas comparados, quando a comparação está pronta; ou
 * "em preparação", com as candidaturas do registro no TSE. A rota existe para
 * as 27 UFs nos dois casos, para o endereço não mudar quando os dados chegarem.
 */
import Base from '../../layouts/Base.astro';
import CandidatosComparados from '../../components/CandidatosComparados.astro';
import Comparacao from '../../components/Comparacao.astro';
import { CARGOS_POR_UF, UFS, caminhoUf, rotuloEscopo } from '../../lib/cargos.mjs';
import { SNAPSHOT_BR, candidaturas, notaSituacao, separaPorDisputa } from '../../lib/candidaturas-uf.mjs';
import { comparacao, paginaPorId, paginasProntas, resumoDoEscopo } from '../../lib/comparacao-dados.mjs';

export function getStaticPaths() {
  return CARGOS_POR_UF.flatMap((cargo) => UFS.map((uf) => ({
    params: { cargo: cargo.slug, uf: uf.sigla.toLowerCase() },
    props: { cargo, uf },
  })));
}
const { cargo, uf } = Astro.props;
const escopo = rotuloEscopo(cargo, uf);
const base = caminhoUf(cargo, uf);
const resumo = resumoDoEscopo(cargo.slug, uf.sigla);
const pronta = resumo.length > 0;
// Decisão do Thiago (16/09): clicar numa UF já mostra a comparação, como na home. A
// página da UF É a matriz do primeiro tema pronto; o seletor leva aos demais, e o
// endereço daquele tema redireciona para cá. A lista de candidaturas do TSE fica só
// para "em preparação".
const prontas = paginasProntas(cargo.slug, uf.sigla);
const dados = pronta ? comparacao(cargo.slug, uf.sigla, prontas[0]) : null;
const paginas = prontas.map((id) => paginaPorId(id, undefined, cargo.slug));
// as candidaturas do snapshot do TSE, em ordem alfabética: quem está na
// disputa e quem saiu (renúncia, indeferimento sem recurso), com a situação do TSE
const { emDisputa, fora } = separaPorDisputa(candidaturas(cargo.slug, uf.sigla));
---
<Base title={pronta ? `${escopo} — os programas comparados por tema` : `${escopo} — em preparação`}
  description={pronta
    ? `Os programas de governo das candidaturas a ${cargo.nome.toLowerCase()} — ${uf.nome} — em 2026, comparados em ${resumo.length} temas.`
    : `A comparação dos programas de governo das candidaturas a ${cargo.nome.toLowerCase()} — ${uf.nome} — em 2026 está em preparação.`}>
  <div class="hero-home">
    <h1>{`Compare os programas dos candidatos a ${escopo}`}</h1>
    {!pronta && (
      <p class="lead">
        A comparação dos programas de governo deste estado está <strong>em preparação</strong>.
        Enquanto isso, as candidaturas registradas no TSE estão abaixo, com o link de cada uma.
        <a href={cargo.href}>Trocar de estado</a> · <a href="/presidente">Ver a comparação para presidente</a>
      </p>
    )}
  </div>

  {pronta && (
    <>
      <Comparacao dados={dados} base={base} paginas={paginas} naHome />
      <CandidatosComparados candidatos={resumo[0].candidatos} cargo={cargo.slug} uf={uf.sigla} />
    </>
  )}

  {!pronta && (
  <section class="secao-catalogo">
    <h2>Candidatos a {cargo.nome.toLowerCase()} — {uf.nome}</h2>
    <ul class="grade-candidatos">
      {emDisputa.map((c) => (
        <li class="cartao-candidato">
          <img src={c.foto} width="161" height="225" loading="lazy" alt="" />
          <span class="nome-candidato">{c.nome}</span>
          <p class="ficha-candidato">
            {c.partido ?? '—'}{c.numero ? ` · nº ${c.numero}` : ''}
            <span class="situacao">{c.situacao}{notaSituacao(c.situacao) ? ` · ${notaSituacao(c.situacao)}` : ''}</span>
          </p>
          <p class="link-tse">
            <a href={c.tse} target="_blank" rel="noopener noreferrer" data-evento="tse_aberto" data-slug={c.slug}>Ver no TSE ↗</a>
          </p>
        </li>
      ))}
    </ul>
    <p class="depois-da-faixa">
      Foto, nome de urna, número, partido e situação são os do registro no TSE em {SNAPSHOT_BR}; o link
      abre a candidatura no DivulgaCandContas, em nova aba. Candidatura indeferida com recurso pendente
      pode fazer campanha até o julgamento, por isso continua na lista.
    </p>
    {fora.length > 0 && (
      <details class="fora-da-disputa">
        <summary>Fora da disputa segundo o TSE em {SNAPSHOT_BR} ({fora.length})</summary>
        <p>
          Renúncias e registros indeferidos sem recurso. Continuam aqui porque o registro existiu;
          a situação é a do TSE, não uma avaliação nossa.
        </p>
        <ul class="grade-candidatos">
          {fora.map((c) => (
            <li class="cartao-candidato fora">
              <img src={c.foto} width="161" height="225" loading="lazy" alt="" />
              <span class="nome-candidato">{c.nome}</span>
              <p class="ficha-candidato">
                {c.partido ?? '—'}{c.numero ? ` · nº ${c.numero}` : ''}
                <span class="situacao"><strong>{c.situacao}</strong></span>
              </p>
              <p class="link-tse">
                <a href={c.tse} target="_blank" rel="noopener noreferrer" data-evento="tse_aberto" data-slug={c.slug}>Ver no TSE ↗</a>
              </p>
            </li>
          ))}
        </ul>
      </details>
    )}
  </section>
  )}

  <style>
    .hero-home { margin-bottom: 1rem; }
    .hero-home .lead { max-width: none; }
    .depois-da-faixa { margin-top: 1rem; color: var(--tinta-suave); font-size: .92rem; }
    .grade-candidatos {
      display: grid;
      grid-template-columns: repeat(auto-fill, 161px);
      justify-content: start;
      gap: 1rem;
      padding: 0;
      margin: 1.5rem 0;
      list-style: none;
    }
    .cartao-candidato {
      overflow: hidden;
      display: flex;
      flex-direction: column;
      min-width: 0;
      border: 1px solid var(--linha);
      border-radius: var(--raio);
      background: var(--cartao);
      box-shadow: var(--sombra-leve);
    }
    .cartao-candidato img {
      display: block;
      width: 100%;
      margin: 0;
      aspect-ratio: 161 / 225;
      object-fit: cover;
      background: var(--realce);
    }
    .cartao-candidato.fora img { filter: grayscale(1); opacity: .75; }
    .nome-candidato {
      display: block;
      padding: .8rem 1rem .25rem;
      font-family: var(--fonte-titulo);
      font-size: 1.02rem;
      font-weight: 750;
      line-height: 1.2;
    }
    .ficha-candidato { flex: 1; margin: 0; padding: .2rem 1rem .4rem; color: var(--tinta-suave); font-size: .84rem; }
    .situacao { display: block; margin-top: .2rem; font-size: .8rem; }
    .link-tse { margin: 0; padding: .2rem 1rem .8rem; font-size: .86rem; }
    .link-tse a { color: var(--acento); font-weight: 600; }
    .fora-da-disputa { margin-top: 1.5rem; }
    .fora-da-disputa summary { cursor: pointer; font-weight: 600; color: var(--acento); min-height: var(--alvo); display: flex; align-items: center; }
  </style>
</Base>
