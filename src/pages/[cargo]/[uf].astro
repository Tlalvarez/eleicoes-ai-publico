---
/**
 * A conversa sobre um cargo numa UF: o mesmo chat da home, com o escopo
 * ("Governador de São Paulo") na frente de cada pergunta, à vista.
 */
import Base from '../../layouts/Base.astro';
import Chat from '../../components/Chat.astro';
import { CARGOS_POR_UF, UFS, caminhoUf, rotuloEscopo } from '../../lib/cargos.mjs';
import { candidaturas } from '../../lib/candidaturas-uf.mjs';

export function getStaticPaths() {
  return CARGOS_POR_UF.flatMap((cargo) => UFS.map((uf) => ({
    params: { cargo: cargo.slug, uf: uf.sigla.toLowerCase() },
    props: { cargo, uf },
  })));
}
const { cargo, uf } = Astro.props;
const escopo = rotuloEscopo(cargo, uf);
const pagina = caminhoUf(cargo, uf);
// os cards saem do snapshot do TSE: todo candidato do cargo nesta UF, em
// ordem alfabética — nenhum nome escrito à mão, nenhuma hierarquia
const cards = candidaturas(cargo.slug, uf.sigla);

// o mesmo critério da home (ver index.astro): sem PUBLIC_PESQUISA_API, mesma
// origem; localhost só em desenvolvimento
const apiBase = import.meta.env.PUBLIC_PESQUISA_API
  ?? (import.meta.env.DEV ? 'http://localhost:8765' : '');
---
<Base title={`${escopo} — pergunte à IA`} description={`Converse com as evidências reunidas sobre as candidaturas a ${cargo.nome.toLowerCase()} — ${uf.nome} — em 2026.`}>
  <div class="hero-home">
    <p class="sobretitulo">Eleições gerais de 2026 · {cargo.nome}</p>
    <h1>{escopo}</h1>
    <p class="lead">
      Pergunte à IA sobre os candidatos a {cargo.nome.toLowerCase()} — {uf.nome} ({uf.sigla}).
      <a href={cargo.href}>Trocar de estado</a>
    </p>
  </div>

  <Chat apiBase={apiBase} escopo={escopo} pagina={pagina}
    placeholder={`Ex.: o que os candidatos a ${cargo.nome.toLowerCase()} propõem para a segurança pública?`} />

  <section class="secao-catalogo">
  <h2>Candidatos a {cargo.nome.toLowerCase()} — {uf.nome}</h2>
  <ul class="grade-candidatos">
    {cards.map((c) => (
      <li class="cartao-candidato">
        <a class="retrato-link" href={`${pagina}/${c.slug}`}
          title={`Conversar com a IA sobre ${c.nome}`}>
          <img src={c.foto} width="161" height="225" loading="lazy" alt="" />
          <span class="nome-candidato">{c.nome}</span>
        </a>
        <p class="ficha-candidato">
          {c.partido ?? '—'}{c.numero ? ` · nº ${c.numero}` : ''}
          <span class="situacao">{c.situacao}</span>
        </p>
        <p class="link-tse">
          <a href={c.tse} target="_blank" rel="noopener noreferrer">Ver no TSE ↗</a>
        </p>
      </li>
    ))}
  </ul>
  <p class="depois-da-faixa">
    Clique no candidato para conversar com a IA só sobre ele. Foto, nome de urna, número,
    partido e situação são os do registro no TSE; o link abre a candidatura no
    DivulgaCandContas, em nova aba.
  </p>
  </section>

  <style>
    .hero-home { margin-bottom: 1.6rem; }
    .depois-da-faixa { margin-top: 1rem; }
    /* os mesmos cards da home */
    .grade-candidatos {
      display: grid;
      grid-template-columns: repeat(auto-fill, 161px);
      justify-content: start;
      gap: 1rem;
      padding: 0;
      margin: 1.5rem 0;
      list-style: none;
    }
    .cartao-candidato {
      overflow: hidden;
      display: flex;
      flex-direction: column;
      min-width: 0;
      border: 1px solid var(--linha);
      border-radius: var(--raio);
      background: var(--cartao);
      box-shadow: var(--sombra-leve);
    }
    .retrato-link { color: var(--tinta); text-decoration: none; }
    .retrato-link img {
      display: block;
      width: 100%;
      margin: 0;
      aspect-ratio: 161 / 225;
      object-fit: cover;
      background: var(--realce);
    }
    .nome-candidato {
      display: block;
      padding: .8rem 1rem .25rem;
      font-family: var(--fonte-titulo);
      font-size: 1.02rem;
      font-weight: 750;
      line-height: 1.2;
    }
    .retrato-link:hover .nome-candidato { color: var(--acento); text-decoration: underline; }
    .ficha-candidato {
      flex: 1;
      margin: 0;
      padding: .2rem 1rem .4rem;
      color: var(--tinta-suave);
      font-size: .84rem;
    }
    .ficha-candidato .situacao { display: block; font-size: .78rem; }
    .link-tse { margin: 0; padding: .2rem 1rem .75rem; font-size: .86rem; }
    .link-tse a { color: var(--acento); font-weight: 600; }
    .hero-home .lead { max-width: none; }
    .sobretitulo {
      margin: 0 0 .6rem;
      color: var(--acento);
      font-size: .79rem;
      font-weight: 800;
      letter-spacing: .13em;
      text-transform: uppercase;
    }
  </style>
</Base>
