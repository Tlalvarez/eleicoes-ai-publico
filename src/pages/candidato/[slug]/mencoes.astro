---
import Base from '../../../layouts/Base.astro';
import ListaItens from '../../../components/ListaItens.astro';
import { leDados } from '../../../lib/dados.mjs';
import { mencoesDoCandidato, raizItens } from '../../../lib/itens.mjs';

// os dados saem do MANIFESTO da geração ativa (data/current.json),
// nunca de um caminho fixo: itens, acervo e índice de pesquisa
// precisam ser sempre da MESMA geração
const resumo = leDados('itens', 'resumo.json');

export function getStaticPaths() {
  // `getStaticPaths` é hoisted pelo Astro e roda FORA do corpo do
  // frontmatter: a leitura tem de acontecer aqui dentro também
  const resumo = leDados('itens', 'resumo.json');
  return Object.keys(resumo.candidatos).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const c = resumo.candidatos[slug];
const mencoes = mencoesDoCandidato(raizItens(), slug, c.anos);
---
<Base
  title={`Menções — ${c.nome}`}
  description={`Links de terceiros que citam ${c.nome}: registro automatizado, sem análise e sem endosso.`}
>
  <p><a href={`/candidato/${slug}`}>← {c.nome}</a></p>
  <h1>Menções — {c.nome}</h1>
  <p class="lead">
    Links de terceiros que citam {c.nome}: vídeos curtos, comentários, coberturas e publicações
    que <em>não</em> são fala integral do candidato e por isso ficam fora da análise.
  </p>
  {mencoes.length === 0
    ? <div class="card"><p style="margin:0">Sem menções registradas no período.</p></div>
    : <ListaItens itens={mencoes} />}
</Base>
