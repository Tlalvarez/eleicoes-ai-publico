---
import Base from '../../../layouts/Base.astro';
import ListaItens from '../../../components/ListaItens.astro';
import resumo from '../../../../data/itens/resumo.json';

export function getStaticPaths() {
  return Object.keys(resumo.candidatos).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const c = resumo.candidatos[slug];
const anosMod = import.meta.glob('../../../../data/itens/*/*.json', { eager: true });
const mencoes = c.anos.flatMap((ano) =>
  (anosMod[`../../../../data/itens/${slug}/${ano}.json`]?.default ?? [])
    .filter((i) => i.voz === 'terceiro'));
---
<Base
  title={`Menções — ${c.nome}`}
  description={`Links de terceiros que citam ${c.nome}: registro automatizado, sem análise e sem endosso.`}
>
  <p><a href={`/candidato/${slug}`}>← {c.nome}</a></p>
  <h1>Menções — {c.nome}</h1>
  <p class="lead">
    Links de terceiros que citam {c.nome}: vídeos curtos, comentários, coberturas e publicações
    que <em>não</em> são fala integral do candidato e por isso ficam fora da análise.
  </p>
  {mencoes.length === 0
    ? <div class="card"><p style="margin:0">Sem menções registradas no período.</p></div>
    : <ListaItens itens={mencoes} />}
  <div class="aviso">
    Coleta automatizada, sem curadoria individual dos conteúdos linkados. Esta seção não é
    análise, não é checagem e não é endosso; volume de menções não indica avaliação.
  </div>
</Base>
