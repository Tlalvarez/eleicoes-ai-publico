---
import Base from '../../../layouts/Base.astro';
import ListaItens from '../../../components/ListaItens.astro';
import { leDados } from '../../../lib/dados.mjs';
import { carregaRecentes, raizItens } from '../../../lib/itens.mjs';
import imagens from '../../../data/imagens-candidatos.json';

// os dados saem do MANIFESTO da geração ativa (data/current.json),
// nunca de um caminho fixo: itens, acervo e índice de pesquisa
// precisam ser sempre da MESMA geração
const resumo = leDados('itens', 'resumo.json');

// link oficial da candidatura, gravado na geração pelo publicador (release-v2);
// geração antiga sem o arquivo apenas não mostra o link
let urlTse = null;
try {
  urlTse = leDados('itens', 'candidaturas.json')[Astro.params.slug]?.url_tse ?? null;
} catch { /* geração sem candidaturas.json */ }

export function getStaticPaths() {
  // `getStaticPaths` é hoisted pelo Astro e roda FORA do corpo do
  // frontmatter: a leitura tem de acontecer aqui dentro também
  const resumo = leDados('itens', 'resumo.json');
  return Object.keys(resumo.candidatos).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const c = resumo.candidatos[slug];
const imagem = imagens.candidates.find((item) => item.candidate_slug === slug);
if (!imagem) throw new Error(`Retrato sem manifesto de direitos: ${slug}`);
const recentes = carregaRecentes(raizItens(), slug);

const voz = recentes.filter((i) => i.voz === 'propria');
const mencoes = recentes.filter((i) => i.voz === 'terceiro');
const destaque = voz.filter((i) => i.tipo !== 'post-x' && i.tipo !== 'post-instagram').slice(0, 10);
const nPosts = voz.filter((i) => i.tipo === 'post-x' || i.tipo === 'post-instagram').length;
---
<Base
  title={c.nome}
  description={`Rastreamento de ${c.nome}: na própria voz, arquivo de 5 anos e menções — registro automatizado com fontes primárias linkadas.`}
>
  <p><a href="/candidato">← Todos os candidatos</a></p>
  <section class="perfil-candidato" aria-labelledby="nome-candidato">
    <figure class="foto-perfil">
      <img
        src={imagem.image_path}
        width="161"
        height="225"
        alt={`Retrato de ${c.nome}`}
      />
      <figcaption>
        Foto: <a href={imagem.source_page}>{imagem.public_credit}</a> ·
        {imagem.license_url
          ? <a href={imagem.license_url}>{imagem.license}</a>
          : imagem.license}
      </figcaption>
    </figure>
    <div class="perfil-conteudo">
      <h1 id="nome-candidato">{c.nome}</h1>
      {urlTse && (
        <p class="lead">
          <a href={urlTse} rel="noopener noreferrer" target="_blank">
            Candidatura oficial no TSE →
          </a>
        </p>
      )}
    </div>
  </section>

  <div class="card">
    <h2 style="margin-top:0">Visões</h2>
    <ul>
      <li><a href={`/candidato/${slug}/voz`}><strong>Na própria voz</strong></a> — tudo que {c.nome} disse nos últimos {resumo.janela_recentes_dias} dias, com link para cada fonte</li>
      <li><a href={`/candidato/${slug}/arquivo`}><strong>Arquivo — 5 anos</strong></a> — histórico desde agosto de 2021, por ano</li>
      <li><a href={`/candidato/${slug}/mencoes`}><strong>Menções</strong></a> — o que circula sobre {c.nome} (fora da análise)</li>
    </ul>
  </div>

  {destaque.length > 0 && (
    <>
      <h2>Recentes na própria voz — conteúdo longo</h2>
      <ListaItens itens={destaque} />
    </>
  )}


  <style>
    .perfil-candidato {
      display: grid;
      grid-template-columns: 161px minmax(0, 1fr);
      gap: clamp(1.25rem, 4vw, 2.5rem);
      align-items: center;
      margin: 1.25rem 0 2rem;
    }
    .foto-perfil {
      overflow: hidden;
      margin: 0;
      border: 1px solid var(--linha);
      border-radius: var(--raio);
      background: var(--cartao);
      box-shadow: var(--sombra-leve);
    }
    .foto-perfil img {
      display: block;
      width: 161px;
      aspect-ratio: 161 / 225;
      object-fit: cover;
    }
    .foto-perfil figcaption {
      padding: .55rem .7rem .65rem;
      color: var(--tinta-suave);
      font-size: .68rem;
      line-height: 1.35;
    }
    .perfil-conteudo h1 { margin-top: 0; }
    .perfil-conteudo .lead { margin-bottom: 0; }
    @media (max-width: 620px) {
      .perfil-candidato { grid-template-columns: minmax(0, 1fr); align-items: start; }
      .foto-perfil { max-width: 15rem; }
    }
  </style>
</Base>
