---
import Base from '../../../layouts/Base.astro';
import { leDados } from '../../../lib/dados.mjs';
import { anosDoArquivo, raizItens, resumoPorAno } from '../../../lib/itens.mjs';

// os dados saem do MANIFESTO da geração ativa (data/current.json),
// nunca de um caminho fixo: itens, acervo e índice de pesquisa
// precisam ser sempre da MESMA geração
const resumo = leDados('itens', 'resumo.json');

export function getStaticPaths() {
  // `getStaticPaths` é hoisted pelo Astro e roda FORA do corpo do
  // frontmatter: a leitura tem de acontecer aqui dentro também
  const resumo = leDados('itens', 'resumo.json');
  return Object.keys(resumo.candidatos).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const c = resumo.candidatos[slug];
// só os anos deste candidato, um arquivo por vez — o glob eager carregava
// data/itens inteiro (47 arquivos) em cada uma das rotas
const porAno = resumoPorAno(raizItens(), slug, anosDoArquivo(c));
---
<Base noindex
  title={`Arquivo 5 anos — ${c.nome}`}
  description={`Histórico de ${c.nome} desde agosto de 2021: posts, vídeos, aparições, discursos e páginas oficiais arquivadas, com fonte primária linkada.`}
>
  <p><a href={`/candidato/${slug}`}>← {c.nome}</a></p>
  <h1>Arquivo — {c.nome}, 5 anos</h1>
  <p class="lead">
    Tudo que registramos de {c.nome} no conteúdo que ele mesmo publicou (e de assessorias oficiais arquivadas)
    desde agosto de 2021, ano a ano. Vídeos, aparições, discursos e publicações são listados
    individualmente; posts de redes aparecem como contadores mensais.
  </p>
  <div class="card">
    <ul>
      {porAno.map((a) => (
        <li>
          <a href={`/candidato/${slug}/arquivo/${a.ano}`}><strong>{a.ano}</strong></a> —
          {a.total.toLocaleString('pt-BR')} itens ({a.longos} de conteúdo longo · {a.posts.toLocaleString('pt-BR')} posts)
        </li>
      ))}
    </ul>
  </div>
</Base>
