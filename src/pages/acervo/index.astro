---
import Base from '../../layouts/Base.astro';
import { leDados } from '../../lib/dados.mjs';
import { opcoesDeFiltro, visaoDoAcervo } from '../../lib/acervo-visao.mjs';

// os dados saem do MANIFESTO da geração ativa (data/current.json),
// nunca de um caminho fixo: itens, acervo e índice de pesquisa
// precisam ser sempre da MESMA geração
const indice = leDados('acervo', 'indice.json');

// A visão (ordem, rótulos, lacunas, links) vive em src/lib/acervo-visao.mjs
// para poder ser cobrada por teste: é lá que estão as regras de cobertura e
// de tratamento igual entre candidatos.
const visao = visaoDoAcervo(indice);
const opcoes = opcoesDeFiltro(visao);

const n = new Intl.NumberFormat('pt-BR');
const plural = (q, um, muitos) => `${n.format(q)} ${q === 1 ? um : muitos}`;

/** O texto que a busca da página varre — nome, slug e os canais de origem. */
const textoDeBusca = (c) =>
  [c.nome, c.slug, ...c.fontes.flatMap((f) => [f.rotulo, f.fonte, f.tipo])].join(' ');
---
<Base
  title="Acervo"
  description="Todo o material reunido sobre cada candidato, organizado por candidato e por fonte, com link até cada registro e até a fonte original."
>
  <h1>Acervo</h1>
  <p class="lead">
    Todo o material reunido sobre os candidatos, organizado <strong>por candidato</strong> e
    <strong>por fonte</strong>, com link até cada registro e até o endereço original.
    Esta página é superfície de evidência: ela mostra o que existe, de onde veio e o que
    falta — não produz posição, comparação nem juízo sobre ninguém.
  </p>

  <p class="cobertura">
    O catálogo declara <strong>{plural(visao.totais.candidatos, 'candidato', 'candidatos')}</strong>.
    {visao.totais.comColeta > 0 && <>
      {' '}Há material coletado de <strong>{n.format(visao.totais.comColeta)}</strong>,
      somando {plural(visao.totais.registros, 'registro', 'registros')}.
    </>}
    {visao.totais.semColeta > 0 && <>
      {' '}Os outros <strong>{n.format(visao.totais.semColeta)}</strong> não têm nenhum
      registro coletado até aqui e aparecem abaixo com a lacuna declarada — sumir com quem
      não tem material transformaria buraco de cobertura em aparência de completude.
    </>}
  </p>

  <form class="filtros" id="filtros" hidden>
    <div class="campo-busca">
      <label for="f-busca">Buscar por candidato ou fonte</label>
      <input type="search" id="f-busca" name="busca" class="campo" autocomplete="off"
        placeholder="nome do candidato, YouTube, Senado…" />
    </div>
    <div class="linha-selects">
      <div>
        <label for="f-candidato">Candidato</label>
        <select id="f-candidato" name="candidato" class="campo">
          <option value="">Todos</option>
          {opcoes.candidatos.map((o) => <option value={o.valor}>{o.rotulo}</option>)}
        </select>
      </div>
      <div>
        <label for="f-fonte">Fonte</label>
        <select id="f-fonte" name="fonte" class="campo">
          <option value="">Todas</option>
          {opcoes.fontes.map((o) => <option value={o.valor}>{o.rotulo}</option>)}
        </select>
      </div>
      <div>
        <label for="f-ano">Ano</label>
        <select id="f-ano" name="ano" class="campo">
          <option value="">Todos</option>
          {opcoes.anos.map((o) => <option value={o.valor}>{o.rotulo}</option>)}
        </select>
      </div>
    </div>
    <div class="acoes-filtro">
      <button type="button" class="botao secundario" id="limpar">Limpar filtros</button>
      <p class="resultado-filtro" id="resultado-filtro" role="status" aria-live="polite"></p>
    </div>
  </form>

  <noscript>
    <div class="aviso">
      Os filtros de busca precisam de JavaScript. <strong>O acervo inteiro está listado
      abaixo</strong>, por candidato e por fonte, com todos os links — nada aqui depende
      de script para ser lido.
    </div>
  </noscript>

  <nav class="atalhos" aria-label="Ir para um candidato">
    <span class="atalhos-rotulo">Ir para:</span>
    <ul>
      {visao.candidatos.map((c) => (
        <li><a href={`#acervo-${c.slug}`}>{c.nome}</a></li>
      ))}
    </ul>
  </nav>

  <div id="lista-acervo">
    {visao.candidatos.map((c) => (
      <section class="bloco-candidato" id={`acervo-${c.slug}`}
        data-candidato={c.slug} data-busca={textoDeBusca(c)}
        data-sem-coleta={c.semColeta ? 'sim' : 'nao'}>
        <h2><a href={c.href}>{c.nome}</a></h2>
        <p class="meta-candidato">
          {c.semColeta
            ? 'Sem registros no acervo.'
            : `${plural(c.total, 'registro', 'registros')} · ${plural(c.fontes.length, 'fonte', 'fontes')} · ${c.anos.length} ${c.anos.length === 1 ? 'ano' : 'anos'}`}
        </p>

        {c.semColeta ? (
          <p class="lacuna">
            <strong>Lacuna de cobertura.</strong> Este candidato está no catálogo publicado e
            ainda não entrou na fila de coleta, então não há um único registro para mostrar.
            A ausência é do coletor, não do candidato — e é declarada aqui em vez de omitida.
          </p>
        ) : (
          <div class="fontes-grade">
            {c.fontes.map((f) => (
              <article class="grupo" data-candidato={c.slug} data-fonte={f.tipo}
                data-anos={f.anos.map((a) => a.ano).join(' ')}
                data-busca={`${c.nome} ${c.slug} ${f.rotulo} ${f.fonte} ${f.tipo}`}>
                <h3>{f.rotulo}</h3>
                <p class="canal">{f.fonte} · {plural(f.total, 'registro', 'registros')}</p>
                <ul class="anos">
                  {f.anos.map((a) => (
                    <li class="ano-link" data-ano={a.ano}>
                      <a href={a.href}>{a.rotulo} <small>({n.format(a.total)})</small></a>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        )}
      </section>
    ))}
  </div>

  <p class="vazio-filtro" id="vazio-filtro" hidden>
    Nenhum candidato ou fonte combina com esses filtros.
    <button type="button" class="botao secundario" id="limpar-vazio">Limpar filtros</button>
  </p>


  <style>
    .cobertura { max-width: 46em; }

    .filtros {
      border: 1px solid var(--linha-forte);
      border-radius: calc(var(--raio) + 4px);
      background: var(--cartao);
      box-shadow: var(--sombra-leve);
      padding: 1rem 1.1rem;
      margin: 1.4rem 0;
    }
    .filtros label {
      display: block;
      font-size: .78rem;
      font-weight: 800;
      letter-spacing: .07em;
      text-transform: uppercase;
      color: var(--acento-forte);
      margin-bottom: .3rem;
    }
    .linha-selects { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; margin-top: .8rem; }
    .acoes-filtro { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem; margin-top: .9rem; }
    .resultado-filtro { margin: 0; font-size: .88rem; color: var(--tinta-suave); }
    @media (max-width: 640px) {
      .linha-selects { grid-template-columns: 1fr; }
      .acoes-filtro > .botao { width: 100%; }
    }

    .atalhos { margin: 1.4rem 0 2rem; font-size: .9rem; }
    .atalhos-rotulo { color: var(--tinta-suave); }
    .atalhos ul { list-style: none; display: flex; flex-wrap: wrap; gap: .3rem; padding: 0; margin: .4rem 0 0; }
    .atalhos a {
      display: inline-flex; align-items: center; min-height: var(--alvo);
      padding: .35rem .7rem; border: 1px solid var(--linha-forte); border-radius: 999px;
      text-decoration: none; color: var(--acento-forte); background: var(--cartao);
    }
    .atalhos a:hover { border-color: var(--azul-claro); background: var(--realce); }

    .bloco-candidato {
      border-top: 2px solid var(--linha);
      padding-top: 1.2rem;
      margin-bottom: 2.2rem;
      scroll-margin-top: 1rem;
    }
    .bloco-candidato h2 { margin-top: 0; }
    .bloco-candidato h2 a { color: inherit; text-decoration: none; }
    .bloco-candidato h2 a:hover { text-decoration: underline; }
    .meta-candidato { color: var(--tinta-suave); font-size: .9rem; margin: 0 0 .9rem; }

    /* Lacuna: amarelo claro, texto azul-marinho. Mesma cor de atenção do site
       inteiro — declara ausência de material, não julga quem está listado. */
    .lacuna {
      border: 1px solid var(--linha-atencao);
      border-left: 4px solid var(--amarelo);
      background: var(--realce-atencao);
      color: var(--acento-forte);
      border-radius: 8px;
      padding: .75rem 1rem;
      font-size: .9rem;
      margin: 0;
      max-width: 46em;
    }

    /* Mesmo cartão, mesma altura de título, mesma ordem de fontes para todos:
       a página não desenha um perfil diferente por candidato. */
    .fontes-grade {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
      gap: .7rem;
    }
    .grupo {
      border: 1px solid var(--linha);
      border-radius: var(--raio);
      background: var(--cartao);
      box-shadow: var(--sombra-leve);
      padding: .85rem 1rem;
    }
    .grupo h3 { margin: 0; font-size: 1rem; color: var(--acento-forte); }
    .canal { margin: .1rem 0 .6rem; font-size: .85rem; color: var(--tinta-suave); }
    .anos { list-style: none; display: flex; flex-wrap: wrap; gap: .3rem; padding: 0; margin: 0; }
    .anos a {
      display: inline-flex; align-items: center; min-height: var(--alvo);
      padding: .3rem .6rem; border: 1px solid var(--linha); border-radius: 6px;
      text-decoration: none; font-size: .88rem; color: var(--acento-forte);
    }
    .anos a:hover { border-color: var(--azul-claro); background: var(--realce); }
    .anos small { color: var(--tinta-suave); margin-left: .2rem; }

    .vazio-filtro { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem; }
    .vazio-filtro[hidden] { display: none; }
  </style>

  <script>
    import { combina } from '../../lib/acervo-visao.mjs';

    const $ = (id) => document.getElementById(id);
    const filtros = $('filtros');
    const vazio = $('vazio-filtro');
    const resultado = $('resultado-filtro');

    // os controles só aparecem quando o script rodou: um filtro visível que
    // não filtra é pior do que filtro nenhum. A lista inteira já está na
    // página, então nada de essencial depende disto.
    filtros.hidden = false;

    const blocos = [...document.querySelectorAll('.bloco-candidato')];
    const grupos = [...document.querySelectorAll('.grupo')];
    const campos = {
      busca: $('f-busca'),
      candidato: $('f-candidato'),
      fonte: $('f-fonte'),
      ano: $('f-ano'),
    };

    const valores = () => Object.fromEntries(
      Object.entries(campos).map(([k, el]) => [k, el.value.trim()]));

    function aplica({ sincronizaUrl = true } = {}) {
      const f = valores();
      const ativo = Object.values(f).some(Boolean);

      for (const g of grupos) {
        const passa = combina({
          candidato: g.dataset.candidato,
          fonte: g.dataset.fonte,
          anos: g.dataset.anos ? g.dataset.anos.split(' ') : [],
          busca: g.dataset.busca,
        }, f);
        g.hidden = !passa;
        // com um ano escolhido, os anos que não são ele saem do cartão: o
        // filtro promete "este ano" e mostrar os outros desmente a promessa
        for (const link of g.querySelectorAll('.ano-link')) {
          link.hidden = Boolean(f.ano) && link.dataset.ano !== f.ano;
        }
      }

      let visiveis = 0;
      for (const b of blocos) {
        const semColeta = b.dataset.semColeta === 'sim';
        const proprios = [...b.querySelectorAll('.grupo')];
        let mostra;
        if (f.candidato && b.dataset.candidato !== f.candidato) {
          mostra = false;
        } else if (semColeta) {
          // candidato sem coleta não tem fonte nem ano: filtrar por um deles
          // legitimamente o exclui — mas busca e candidato ainda o alcançam,
          // e é assim que a lacuna continua visível
          mostra = !f.fonte && !f.ano
            && combina({ candidato: b.dataset.candidato, busca: b.dataset.busca }, f);
        } else {
          mostra = proprios.some((g) => !g.hidden);
        }
        b.hidden = !mostra;
        if (mostra) visiveis += 1;
      }

      vazio.hidden = visiveis > 0;
      resultado.textContent = ativo
        ? `${visiveis} de ${blocos.length} candidatos combinam com os filtros.`
        : '';

      if (sincronizaUrl) {
        const params = new URLSearchParams();
        for (const [k, v] of Object.entries(f)) if (v) params.set(k, v);
        const busca = params.toString();
        history.replaceState(null, '', busca ? `?${busca}` : location.pathname);
      }
    }

    for (const el of Object.values(campos)) {
      el.addEventListener('input', () => aplica());
      el.addEventListener('change', () => aplica());
    }
    filtros.addEventListener('submit', (ev) => ev.preventDefault());

    function limpa() {
      for (const el of Object.values(campos)) el.value = '';
      aplica();
      campos.busca.focus();
    }
    $('limpar').addEventListener('click', limpa);
    $('limpar-vazio').addEventListener('click', limpa);

    // um recorte do acervo é um endereço: ?candidato=…&fonte=…&ano=…&busca=…
    const inicial = new URLSearchParams(location.search);
    let algum = false;
    for (const [k, el] of Object.entries(campos)) {
      const v = inicial.get(k);
      if (v === null) continue;
      // valor que não existe no seletor é ignorado, não aplicado em silêncio
      if (el.tagName === 'SELECT' && ![...el.options].some((o) => o.value === v)) continue;
      el.value = v;
      algum = true;
    }
    if (algum) aplica({ sincronizaUrl: false });
  </script>
</Base>
