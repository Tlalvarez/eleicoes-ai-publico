---
import Base from '../../../layouts/Base.astro';
import indice from '../../../../data/acervo/indice.json';

export function getStaticPaths() {
  return Object.keys(indice.candidatos).map((slug) => ({ params: { slug } }));
}

const ROTULO = {
  video: 'Vídeos (YouTube)', aparicao: 'Aparições', 'post-x': 'Posts no X',
  'post-instagram': 'Posts no Instagram', discurso: 'Discursos no Senado',
  artigo: 'Publicações oficiais', 'pagina-arquivada': 'Páginas arquivadas',
};
const { slug } = Astro.params;
const c = indice.candidatos[slug];
const tipos = Object.entries(c.tipos).sort((a, b) => b[1].total - a[1].total);
---
<Base title={`Acervo — ${c.nome}`} description={`Todo o material coletado de ${c.nome}, por tipo e ano, até o documento original.`}>
  <p><a href="/acervo">← Acervo</a></p>
  <h1>Acervo — {c.nome}</h1>

  {tipos.map(([tipo, d]) => (
    <section class="card">
      <h2>{ROTULO[tipo] ?? tipo} <small>({d.total.toLocaleString('pt-BR')})</small></h2>
      <p>
        {Object.entries(d.anos).map(([ano, n]) => (
          <span style="margin-right:.9rem; display:inline-block">
            <a href={`/acervo/${slug}/${tipo}/${ano}`}>{ano === '0000' ? 'sem data' : ano}</a>
            {' '}<small>({n.toLocaleString('pt-BR')})</small>
          </span>
        ))}
      </p>
    </section>
  ))}
</Base>
