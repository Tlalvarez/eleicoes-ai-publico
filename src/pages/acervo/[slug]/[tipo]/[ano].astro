---
import Base from '../../../../layouts/Base.astro';
import { leDados } from '../../../../lib/dados.mjs';
import { carregaAno, ehPaginadoPorMes, raizAcervo, rotasAno } from '../../../../lib/acervo.mjs';

// os dados saem do MANIFESTO da geração ativa (data/current.json),
// nunca de um caminho fixo: itens, acervo e índice de pesquisa
// precisam ser sempre da MESMA geração
const indice = leDados('acervo', 'indice.json');

export function getStaticPaths() {
  // `getStaticPaths` é hoisted pelo Astro e roda FORA do corpo do
  // frontmatter: a leitura tem de acontecer aqui dentro também
  const indice = leDados('acervo', 'indice.json');
  return rotasAno(indice);
}

const ROTULO = {
  video: 'Vídeos (YouTube)', aparicao: 'Aparições', 'post-x': 'Posts no X',
  'post-instagram': 'Posts no Instagram', discurso: 'Discursos no Senado',
  artigo: 'Publicações oficiais', 'pagina-arquivada': 'Páginas arquivadas',
};
const ROTULO_ITEM = {
  video: 'Vídeo', aparicao: 'Aparição', 'post-x': 'Post no X',
  'post-instagram': 'Post no Instagram', discurso: 'Discurso no Senado',
  artigo: 'Publicação oficial', 'pagina-arquivada': 'Página arquivada',
};
// Decisão (05/09/2026): o site não expõe o texto dos itens — nem o campo
// `texto`, nem transcrição. Cada card é título (ou o rótulo do tipo), data e
// o link para a fonte original. A release v2 carrega texto integral; ele
// fica no serviço de evidências, não numa página consultável.
const { slug, tipo, ano } = Astro.params;
const c = indice.candidatos[slug];
// só o rollup deste ano — o glob eager arrastava o acervo inteiro (inclusive
// as transcrições em <slug>/itens/) para dentro de cada rota
const itens = carregaAno(raizAcervo(), slug, tipo, ano);
const anos = Object.keys(c.tipos[tipo].anos).sort().reverse();
const min = (s) => (s ? ` · ${Math.round(s / 60)} min` : '');
const dataBr = (d) => (d ? d.split('-').reverse().join('/') : 'sem data');

// Anos grandes viram índice de meses (achado da revisão: 3.340 itens numa
// página = 3,9MB/596 telas mobile — impraticável). A regra mora na lib para
// não divergir de quais rotas mensais são geradas.
const paginaPorMes = ehPaginadoPorMes(tipo, itens);
const MESES = ['janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho',
  'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'];
const porMes = new Map();
if (paginaPorMes) {
  for (const i of itens) {
    const m = i.data ? i.data.slice(5, 7) : '00';
    porMes.set(m, (porMes.get(m) ?? 0) + 1);
  }
}
---
<Base title={`${ROTULO[tipo] ?? tipo} ${ano} — ${c.nome}`} description={`${ROTULO[tipo] ?? tipo} de ${c.nome} em ${ano}, com link para a fonte original.`}>
  <p><a href={`/acervo/${slug}`}>← Acervo de {c.nome}</a></p>
  <h1>{c.nome} — {ROTULO[tipo] ?? tipo}, {ano === '0000' ? 'sem data' : ano}</h1>
  <p>
    {anos.map((a) => a === ano
      ? <strong style="margin-right:.7rem">{a === '0000' ? 'sem data' : a}</strong>
      : <a style="margin-right:.7rem" href={`/acervo/${slug}/${tipo}/${a}`}>{a === '0000' ? 'sem data' : a}</a>)}
  </p>

  {paginaPorMes && (
    <ul class="acervo-lista">
      {[...porMes.entries()].sort((a, b) => b[0].localeCompare(a[0])).map(([mes, n]) => (
        <li>
          <a href={`/acervo/${slug}/${tipo}/${ano}/${mes}`}>
            {mes === '00' ? 'Sem data' : `${MESES[Number(mes) - 1]} de ${ano}`}
          </a> — {n.toLocaleString('pt-BR')} posts
        </li>
      ))}
    </ul>
  )}

  <ul class="acervo-lista" hidden={paginaPorMes}>
    {(paginaPorMes ? [] : itens).map((i) => (
      <li>
        <small>{dataBr(i.data)}{i.repost ? ' · repost de terceiro' : ''}{min(i.duracao_s)}</small><br />
        <span>{i.titulo ?? ROTULO_ITEM[tipo] ?? tipo}</span>
        {' '}<a class="fonte-externa" href={i.url} rel="noopener" target="_blank">↗ fonte</a>
      </li>
    ))}
  </ul>

  <style>
    .acervo-lista { list-style: none; padding: 0; }
    .acervo-lista li { margin-bottom: 1rem; border-bottom: 1px solid rgba(127,127,127,.25); padding-bottom: .6rem; overflow-wrap: anywhere; }
    .fonte-externa { white-space: nowrap; }
  </style>
</Base>
