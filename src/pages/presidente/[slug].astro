---
/**
 * A conversa só sobre UM candidato a presidente: o mesmo chat da home, com o
 * nome do candidato na frente de cada pergunta, à vista.
 *
 * A lista de candidatos sai do resumo gerado pelo harness (pelo manifesto da
 * geração ativa), como na home: nenhum nome escrito à mão, cobertura
 * simétrica — todo candidato do resumo ganha a sua página.
 */
import Base from '../../layouts/Base.astro';
import Chat from '../../components/Chat.astro';
import { leDados } from '../../lib/dados.mjs';
import { candidatosDaHome } from '../../lib/home.mjs';
import imagens from '../../data/imagens-candidatos.json';
import { urlCandidaturaTse } from '../../lib/tse.mjs';

export function getStaticPaths() {
  const resumo = leDados('itens', 'resumo.json');
  const imagensPorSlug = new Map(imagens.candidates.map((imagem) => [imagem.candidate_slug, imagem]));
  return candidatosDaHome(resumo).map(({ slug, nome }) => {
    const imagem = imagensPorSlug.get(slug);
    if (!imagem) throw new Error(`Retrato sem manifesto de direitos: ${slug}`);
    return { params: { slug }, props: { slug, nome, imagem, tse: urlCandidaturaTse(slug) } };
  });
}
const { slug, nome, imagem, tse } = Astro.props;
const pagina = `/presidente/${slug}`;

// o mesmo critério da home (ver index.astro): sem PUBLIC_PESQUISA_API, mesma
// origem; localhost só em desenvolvimento
const apiBase = import.meta.env.PUBLIC_PESQUISA_API
  ?? (import.meta.env.DEV ? 'http://localhost:8765' : '');
---
<Base title={`${nome} — pergunte à IA`} description={`Converse com as evidências reunidas sobre ${nome}, candidatura a presidente em 2026.`}>
  <div class="hero-home">
    <p class="sobretitulo">Eleições gerais de 2026 · Presidente</p>
    <div class="cabecalho-candidato">
      <img class="retrato" src={imagem.image_path} width="92" height="128" alt="" />
      <div>
        <h1>{nome}</h1>
        <p class="lead">
          Pergunte à IA só sobre {nome}: o nome vai na frente de cada pergunta enviada.
        </p>
        <p class="links-candidato">
          <a href={tse} target="_blank" rel="noopener noreferrer">Candidatura no TSE ↗</a>
          <a href="/">Todos os candidatos a presidente</a>
        </p>
      </div>
    </div>
  </div>

  <Chat apiBase={apiBase} escopo={nome} pagina={pagina}
    placeholder={`Ex.: o que ${nome} propõe para a educação?`} />

  <style>
    .hero-home { margin-bottom: 1.6rem; }
    .hero-home .lead { max-width: none; margin-bottom: .4rem; }
    .sobretitulo {
      margin: 0 0 .6rem;
      color: var(--acento);
      font-size: .79rem;
      font-weight: 800;
      letter-spacing: .13em;
      text-transform: uppercase;
    }
    .cabecalho-candidato { display: flex; gap: 1.1rem; align-items: flex-start; }
    .cabecalho-candidato h1 { margin-top: 0; }
    .retrato {
      flex: 0 0 92px;
      width: 92px;
      height: 128px;
      object-fit: cover;
      border-radius: var(--raio);
      border: 1px solid var(--linha);
      background: var(--realce);
    }
    .links-candidato { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; margin: 0; font-size: .92rem; }
    .links-candidato a { color: var(--acento); font-weight: 600; }
    @media (max-width: 520px) {
      .cabecalho-candidato { flex-direction: column; }
    }
  </style>
</Base>
