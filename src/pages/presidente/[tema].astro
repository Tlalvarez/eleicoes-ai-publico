---
/**
 * A comparação de um tema para Presidente: /presidente/<pagina>.
 * Uma rota por arquivo em data/comparacao/presidente/.
 */
import Base from '../../layouts/Base.astro';
import Comparacao from '../../components/Comparacao.astro';
import { comparacao, paginaPorId, paginasProntas } from '../../lib/comparacao-dados.mjs';

export function getStaticPaths() {
  // o primeiro tema NÃO vira página: ele é a home (decisão do Thiago, 16/09). Se o
  // arquivo existisse, a Cloudflare serviria o arquivo e nunca o redirecionamento.
  const prontas = paginasProntas('presidente');
  return prontas.slice(1).map((id) => ({ params: { tema: id }, props: { dados: comparacao('presidente', null, id) } }));
}
const { dados } = Astro.props;
const paginas = paginasProntas('presidente').map((id) => paginaPorId(id));
const n = dados.candidatos.length;
---
<Base title={`${dados.titulo} · Presidente 2026`}
  description={`${dados.nome}: ${dados.propostas.length} propostas dos programas de governo de ${n} candidatos a presidente em 2026, lado a lado, com o trecho de cada programa.`}>
  <div class="hero-home">
    <h1>Compare os programas dos candidatos a Presidente</h1>
  </div>
  <Comparacao dados={dados} base="/presidente" paginas={paginas} />
  <style>
    .hero-home { margin-bottom: 1rem; }
  </style>
</Base>
