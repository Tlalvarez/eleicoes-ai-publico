---
/**
 * Presidente: os temas comparados e os programas que entram na comparação.
 */
import Base from '../../layouts/Base.astro';
import Candidatos from '../../components/Candidatos.astro';
import GradeTemas from '../../components/GradeTemas.astro';
import Busca from '../../components/Busca.astro';
import { comparacao, resumoDoEscopo } from '../../lib/comparacao-dados.mjs';

const resumo = resumoDoEscopo('presidente');
const candidatos = resumo.length ? comparacao('presidente', null, resumo[0].id).candidatos : [];
const totalPropostas = resumo.reduce((n, r) => n + r.propostas, 0);
---
<Base title="Presidente - os programas de governo comparados por tema"
  description={`Os programas de governo de ${candidatos.length} candidatos a presidente em 2026, comparados em ${resumo.length} temas: ${totalPropostas} propostas, com o trecho de cada programa.`}>
  <div class="hero-home">
    <p class="sobretitulo">Eleições gerais de 2026 · Presidente</p>
    <h1>Os programas de governo, tema a tema</h1>
    <p class="lead">
      {totalPropostas} propostas em {resumo.length} temas. Em cada tema, uma proposta feita por mais de um
      candidato aparece uma vez, sobre as colunas de quem a faz; quem propõe o contrário aparece marcado.
      Toque na proposta para ler o trecho do programa.
    </p>
  </div>

  <Busca compacta />

  <h2>Temas</h2>
  <GradeTemas resumo={resumo} base="/presidente" origem="hub" />

  <h2>Programas comparados</h2>
  <p class="explica">
    Os programas registrados no TSE por estes candidatos, em ordem alfabética. A foto é a oficial
    do registro; o link abre o programa no TSE, em nova aba.
  </p>
  <Candidatos candidatos={candidatos} />

  <style>
    .hero-home { margin-bottom: 1.2rem; }
    .hero-home .lead { max-width: none; }
    .sobretitulo {
      margin: 0 0 .6rem;
      color: var(--acento);
      font-size: .79rem;
      font-weight: 800;
      letter-spacing: .13em;
      text-transform: uppercase;
    }
    .explica { margin: 0; color: var(--tinta-suave); }
  </style>
</Base>
