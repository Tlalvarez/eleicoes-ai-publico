---
/**
 * A home: a comparação já aberta, no primeiro tema de Presidente.
 *
 * Decisão do Thiago (16/09/2026): a matriz é o produto, e chegar nela não pode
 * custar um clique. A home passou a ser a própria página de comparação do
 * primeiro tema — a grade de temas saiu (o seletor da matriz faz esse papel) e a
 * busca separada também (a matriz tem a sua, que filtra na hora). O endereço do
 * primeiro tema redireciona para cá, para não haver duas páginas iguais.
 *
 * Governador tem a sua seção, pelo menu do cabeçalho.
 */
import Base from '../layouts/Base.astro';
import Comparacao from '../components/Comparacao.astro';
import CandidatosComparados from '../components/CandidatosComparados.astro';
import { comparacao, paginaPorId, paginasProntas } from '../lib/comparacao-dados.mjs';

const prontas = paginasProntas('presidente');
const primeiro = prontas[0];
const dados = primeiro ? comparacao('presidente', null, primeiro) : null;
const paginas = prontas.map((id) => paginaPorId(id));
const candidatos = dados ? dados.candidatos : [];
---
<Base title="Eleições 2026 - Compare os programas de governo"
  description="O que cada candidato de 2026 registrou no programa de governo, tema a tema: onde os programas convergem, onde divergem e o que não tratam. Com o trecho de cada programa.">
  <div class="hero-home">
    <h1>Compare os programas dos candidatos a Presidente</h1>
    {/* A linha "Prefere perguntar? Use o acervo no seu ChatGPT ou Claude" saiu em 19/09/2026, por
        decisão do Thiago: no protótipo B a caixa logo abaixo já convida a perguntar, e mandar a pessoa
        embora para outro produto na primeira linha da home é o contrário disso. A /ia continua
        indexável e linkada no rodapé; quem chega como assistente recebe o cartão pela Function. */}
  </div>

  {dados
    ? <Comparacao dados={dados} base="/presidente" paginas={paginas} trilha={[]} naHome />
    : <p class="lead">A comparação de presidente está em preparação.</p>}

  <CandidatosComparados candidatos={candidatos} cargo="presidente" />

  <style>
    .hero-home { margin-bottom: 1rem; }
    .hero-home .lead { max-width: none; }
  </style>
</Base>
