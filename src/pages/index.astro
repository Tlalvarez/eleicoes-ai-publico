---
/**
 * A home: a porta de entrada da comparação de programas — os temas de
 * Presidente. Governador entra quando houver comparação de alguma UF
 * (`menu: true` em src/lib/cargos.mjs). Sem chat: o produto é a comparação,
 * tema a tema, dos programas registrados no TSE.
 */
import Base from '../layouts/Base.astro';
import GradeTemas from '../components/GradeTemas.astro';
import GradeUfs from '../components/GradeUfs.astro';
import Busca from '../components/Busca.astro';
import { CARGOS_NO_MENU } from '../lib/cargos.mjs';
import { comparacao, resumoDoEscopo } from '../lib/comparacao-dados.mjs';

const resumo = resumoDoEscopo('presidente');
const candidatos = resumo.length ? comparacao('presidente', null, resumo[0].id).candidatos : [];
const totalPropostas = resumo.reduce((n, r) => n + r.propostas, 0);
const porUfNoMenu = CARGOS_NO_MENU.filter((c) => c.porUF);
---
<Base title="Eleições 2026 - Compare os programas de governo"
  description="O que cada candidato de 2026 registrou no programa de governo, tema a tema: onde os programas convergem, onde divergem e sobre o que calam. Com o trecho de cada programa.">
  <div class="hero-home">
    <p class="sobretitulo">Eleições gerais de 2026</p>
    <h1>Compare os programas de governo, tema a tema</h1>
    <p class="lead">
      O que cada candidato <strong>registrou na Justiça Eleitoral</strong>: onde os programas
      convergem, onde divergem e sobre o que calam. Só programas, com o trecho de cada um a um toque.
      Sem recomendação de voto.
    </p>
  </div>

  <Busca />

  <section class="bloco">
    <h2>Presidente</h2>
    <p class="explica">
      {resumo.length} temas, {totalPropostas} propostas dos programas de {candidatos.length} candidatos.
    </p>
    <GradeTemas resumo={resumo} base="/presidente" origem="home" />
  </section>

  {porUfNoMenu.map((cargo) => (
    <section class="bloco">
      <h2>{cargo.nome}</h2>
      <p class="explica">Os programas são por estado. Escolha o seu.</p>
      <GradeUfs cargo={cargo} />
    </section>
  ))}

  <style>
    .hero-home { margin-bottom: 1.6rem; }
    .hero-home .lead { max-width: none; }
    .sobretitulo {
      margin: 0 0 .6rem;
      color: var(--acento);
      font-size: .79rem;
      font-weight: 800;
      letter-spacing: .13em;
      text-transform: uppercase;
    }
    .bloco h2 { margin-top: 1.6rem; }
    .explica { margin: 0; color: var(--tinta-suave); }
  </style>
</Base>
