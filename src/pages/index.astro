---
import Base from '../layouts/Base.astro';
import { leDados } from '../lib/dados.mjs';
import { candidatosDaHome, chipsDaHome } from '../lib/home.mjs';

// os dados saem do MANIFESTO da geração ativa (data/current.json),
// nunca de um caminho fixo: itens, acervo e índice de pesquisa
// precisam ser sempre da MESMA geração
const resumo = leDados('itens', 'resumo.json');

// Cards e sugestões saem do resumo gerado pelo harness, no mesmo molde e na
// mesma ordem: uma home que citasse cinco nomes escritos à mão quebraria a
// cobertura simétrica logo na primeira página.
const candidatos = candidatosDaHome(resumo);
const chips = chipsDaHome(resumo);

// Endereço do serviço de evidências. Sem `PUBLIC_PESQUISA_API`, o padrão é a
// MESMA ORIGEM ('') — o cliente pede `/api/conversa` relativo, e quem publica
// põe o serviço atrás do mesmo domínio.
//
// O padrão anterior era `http://localhost:8765`, e ele chegou ao `dist/`: um
// build público assim manda o navegador do VISITANTE procurar o serviço na
// máquina dele, e antes disso é barrado como conteúdo misto dentro de https.
// Localhost só sobrevive em desenvolvimento, onde o `astro dev` roda noutra
// porta que o serviço. Os dois lados são cobrados por gate:
// scripts/checa-home-fonte.mjs (origem) e scripts/checa-home-dist.mjs (build).
const apiBase = import.meta.env.PUBLIC_PESQUISA_API
  ?? (import.meta.env.DEV ? 'http://localhost:8765' : '');
---
<Base title="Eleições 2026 - Pergunte à IA sobre os candidatos">
  <div class="hero-home">
    <p class="sobretitulo">Eleições gerais de 2026</p>
    <h1>Pergunte à IA sobre os candidatos</h1>
    <p class="lead">
      Reunimos neste site apenas <strong>materiais oficiais</strong> e <strong>citações diretas</strong> dos candidatos
      publicadas nos últimos cinco anos. Nosso objetivo é oferecer informações que possam ser
      atribuídas com segurança a cada candidato, reduzindo o risco de desinformação e ajudando
      você a fazer uma escolha mais consciente na hora de votar.
    </p>
  </div>

  <section class="chat" id="chat" aria-label="Conversa com o acervo" data-api={apiBase}>
    <ol class="conversa" id="conversa"></ol>

    <p class="estado-chat" id="estado" role="status" aria-live="polite" hidden>
      <span class="girando" aria-hidden="true"></span>
      <span id="estado-texto"></span>
      <button type="button" class="botao secundario compacto" id="cancelar" hidden>Cancelar</button>
    </p>

    <form id="form-chat" method="get" action="/" class="form-chat">
      <label class="sr-only" for="q">Sua pergunta sobre os candidatos</label>
      <textarea id="q" name="q" class="campo" rows="2" required
        placeholder="Ex.: o que o candidato A fala sobre educação em seu plano de governo? Compare quem tratou do tema X."
        autocomplete="off"></textarea>
      <div class="acoes-envio">
        <button type="submit" class="botao" id="enviar">Perguntar</button>
        <button type="button" class="botao secundario" id="nova" hidden>Começar outra conversa</button>
      </div>
      <p class="nota-envio">
        <kbd>Enter</kbd> envia · <kbd>Shift</kbd>+<kbd>Enter</kbd> quebra linha ·
        a resposta pode levar alguns minutos para ser computada.
      </p>
    </form>

    <ul class="sugestoes" id="sugestoes" aria-label="Perguntas de exemplo">
      {chips.map((c) => (
        <li><a class="sugestao" href={c.href} data-pergunta={c.pergunta}>{c.pergunta}</a></li>)
      )}
    </ul>
  </section>

  <noscript>
    <div class="aviso">
      <strong>Sem JavaScript, a conversa não roda.</strong> Ela depende do serviço de
      evidências, que responde por requisição. Todo o material continua navegável sem
      JavaScript: veja <a href="/acervo">o acervo por candidato e por fonte</a>, o
      <a href="/candidato">rastreamento por candidato</a> e a
      <a href="/metodologia">metodologia</a>.
    </div>
  </noscript>

  <h2>Quem está no acervo</h2>
  <p>
    A mesma varredura, a mesma régua e o mesmo tratamento para todos — inclusive para quem
    ainda não tem material coletado, que aparece aqui com a lacuna declarada.
  </p>
  <ul class="faixa-candidatos">
    {candidatos.map(({ slug, nome }) => (
      <li><a href={`/candidato/${slug}`}>{nome}</a></li>
    ))}
  </ul>
  <p class="depois-da-faixa">
    <a href="/acervo">Todo o acervo, por candidato e por fonte →</a>
  </p>

  <style>
    .hero-home { margin-bottom: 1.6rem; }
    .hero-home .lead { max-width: none; }
    .sobretitulo {
      margin: 0 0 .6rem;
      color: var(--acento);
      font-size: .79rem;
      font-weight: 800;
      letter-spacing: .13em;
      text-transform: uppercase;
    }
    /* o compositor: cartão branco, borda azul, raio e sombra leve */
    .form-chat {
      margin: 1.2rem 0 0;
      padding: .9rem 1rem 1rem;
      background: var(--cartao);
      border: 1px solid var(--linha-forte);
      border-radius: calc(var(--raio) + 6px);
      box-shadow: var(--sombra);
    }
    .form-chat:focus-within { border-color: var(--azul); }
    /* dentro do compositor o campo não desenha caixa própria: a caixa é o
       cartão. O indicador de foco continua sendo o da folha global. */
    .form-chat .campo {
      border-color: transparent;
      background: transparent;
      min-height: 5.5rem;
      padding: .4rem .35rem;
      font-size: 1.06rem;
    }
    .acoes-envio { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .6rem; }
    #nova { display: none; }
    .nota-envio { font-size: .84rem; color: var(--tinta-suave); margin: .5rem 0 0; }
    .nota-envio kbd {
      font: inherit; font-size: .95em; border: 1px solid var(--linha);
      border-bottom-width: 2px; border-radius: 4px; padding: 0 .3em; background: var(--cartao);
    }
    .depois-da-faixa { margin-top: 1rem; }
    @media (max-width: 520px) {
      .acoes-envio > .botao { flex: 1 1 100%; }
    }
  </style>

  <style is:global>
    /* Globais de propósito: a conversa é construída em tempo de execução e os
       elementos criados por script NÃO recebem o atributo de escopo do Astro.
       Estilo escopado simplesmente não casaria com eles. */
    .chat { margin: 1.5rem 0 2rem; }
    .conversa { list-style: none; padding: 0; margin: 0; }
    .turno { margin: 0 0 1.5rem; }

    .turno-pergunta .texto-pergunta {
      font-family: var(--fonte-titulo);
      font-size: clamp(1.15rem, 1.05rem + .6vw, 1.4rem);
      font-weight: 700;
      letter-spacing: -.02em;
      line-height: 1.22;
      color: var(--acento-forte);
      margin: 0 0 .2rem;
      padding-left: .9rem;
      border-left: 4px solid var(--amarelo);
    }
    .turno-pergunta .marca-pergunta {
      font-size: .75rem; text-transform: uppercase; letter-spacing: .12em;
      font-weight: 800; color: var(--acento); padding-left: 1.05rem;
    }

    /* a resposta é um cartão branco com a faixa da identidade no topo */
    .turno-resposta > article {
      overflow: hidden;
      background: var(--cartao);
      border: 1px solid var(--linha);
      border-radius: var(--raio);
      box-shadow: var(--sombra-leve);
      padding: 0 1.3rem 1.2rem;
    }
    .turno-resposta > article::before {
      content: '';
      display: block;
      height: 5px;
      margin: 0 -1.3rem 1.2rem;
      background: linear-gradient(90deg,
        var(--amarelo) 0 34%,
        var(--verde) 34% 52%,
        var(--azul-claro) 52% 78%,
        var(--laranja) 78% 100%);
    }

    .resposta-corpo {
      font-family: var(--fonte-titulo);
      font-size: 1.02rem;
      line-height: 1.7;
      max-width: none;
    }
    .resposta-corpo > :first-child { margin-top: 0; }
    .resposta-corpo h3 { font-size: 1.1rem; margin: 1.5rem 0 .35rem; }
    .resposta-corpo h4 { font-size: 1rem; margin: 1.1rem 0 .3rem; }
    .resposta-corpo ul, .resposta-corpo ol { padding-left: 1.25rem; margin: 0 0 1rem; }
    .resposta-corpo li { margin-bottom: .45rem; }
    .resposta-corpo hr { margin: 1.4rem 0; }
    .marcador-fonte { text-decoration: none; font-weight: 700; font-family: var(--fonte-ui);
      font-size: .8em; padding: 0 .1em; color: var(--acento); }

    .fontes { margin-top: 1.4rem; border-top: 1px solid var(--linha); padding-top: .9rem; }
    .fontes h3 { margin-top: 0; font-size: .84rem; text-transform: uppercase;
      letter-spacing: .09em; color: var(--acento-forte); }
    .fontes ol { list-style: none; padding: 0; margin: 0; counter-reset: none; }
    .fontes li { margin-bottom: .8rem; font-size: .92rem; scroll-margin-top: 1rem; }
    .fontes .marcas { font-weight: 700; font-family: var(--fonte-ui); color: var(--acento); }
    .fontes .link-fonte { color: var(--acento); font-weight: 600; }
    .fontes .fonte-meta { color: var(--tinta-suave); }
    .fontes .ressalva { display: block; font-size: .88em; margin-top: .1rem; }
    .fontes .ressalva.nao-conferido { color: var(--atencao); font-weight: 600; }

    .rodape-resposta {
      margin-top: 1rem; font-size: .85rem; color: var(--tinta-suave);
      border-top: 1px solid var(--linha); padding-top: .7rem;
    }
    .rodape-resposta p { margin: 0 0 .25rem; }

    .barra-compartilhar {
      display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .9rem;
      padding-top: .8rem; border-top: 1px dashed var(--linha);
    }
    .barra-compartilhar .botao { font-size: .88rem; padding: .5rem .85rem; }
    .nota-permalink { flex-basis: 100%; font-size: .82rem; color: var(--tinta-suave); margin: .2rem 0 0; }
    .copia-manual { flex-basis: 100%; margin: .4rem 0 0; }
    .copia-manual textarea { width: 100%; min-height: 7rem; font: inherit; font-size: .85rem; }

    .estado-chat {
      display: flex; align-items: center; gap: .6rem; margin: 1rem 0;
      font-size: .95rem;
    }
    .estado-chat[hidden] { display: none; }
    .estado-chat .botao.compacto { min-height: 36px; padding: .3rem .8rem; font-size: .85rem; }
    .girando {
      width: 1rem; height: 1rem; flex-shrink: 0; border-radius: 50%;
      border: 2px solid var(--linha); border-top-color: var(--amarelo);
      animation: gira .8s linear infinite;
    }
    @keyframes gira { to { transform: rotate(360deg); } }
    .estado-chat.com-erro { color: var(--atencao); font-weight: 600; }
    .estado-chat.com-erro .girando { display: none; }

    /* lacuna e ressalva: amarelo claro com texto azul-marinho, a mesma cor de
       atenção do site inteiro — nunca o estatuto de um candidato */
    .aviso-turno {
      font-size: .86rem; color: var(--acento-forte);
      background: var(--realce-atencao); border: 1px solid var(--linha-atencao);
      border-radius: 8px; padding: .6rem .9rem; margin: .8rem 0 0;
    }
  </style>

  <script>
    import { analisaMarkdown, criaElementos } from '../lib/markdown.mjs';
    import { ErroConversa, carregaResposta } from '../lib/chat.mjs';
    import { criaSessao } from '../lib/sessao-conversa.mjs';
    import { estadoDaResposta } from '../lib/release.mjs';
    import { estadoDoFragmento } from '../lib/permalink.mjs';
    import {
      PARAMETRO_PAGINA, caminhoPagina, urlDeCompartilhamento,
    } from '../lib/resposta-publica.mjs';
    import {
      dataBr, linkWhatsApp, markdownCompleto, payloadWebShare, resumoLegivel,
      textoCompleto,
    } from '../lib/compartilhar.mjs';

    const $ = (id) => document.getElementById(id);
    const chat = $('chat');
    const conversa = $('conversa');
    const form = $('form-chat');
    const entrada = $('q');
    const enviar = $('enviar');
    const nova = $('nova');
    const estado = $('estado');
    const estadoTexto = $('estado-texto');
    const cancelar = $('cancelar');
    const sugestoes = $('sugestoes');

    // histórico, requisição em voo e a regra de época moram em sessao-conversa:
    // aqui só se desenha o que ela devolve
    const sessao = criaSessao({ apiBase: chat.dataset.api });
    let turnos = 0;

    const el = (tag, classe, texto) => {
      const n = document.createElement(tag);
      if (classe) n.className = classe;
      if (texto !== undefined) n.textContent = texto;
      return n;
    };

    // ---------------------------------------------------------------- estado

    function mostraEstado(texto, { erro = false, cancelavel = false } = {}) {
      estado.hidden = false;
      estado.classList.toggle('com-erro', erro);
      estadoTexto.textContent = texto;
      cancelar.hidden = !cancelavel;
    }
    function escondeEstado() {
      estado.hidden = true;
      estado.classList.remove('com-erro');
      cancelar.hidden = true;
    }

    // ------------------------------------------------------------ conversa

    function adicionaPergunta(texto) {
      const li = el('li', 'turno turno-pergunta');
      li.append(el('p', 'marca-pergunta', 'Pergunta'));
      const p = el('p', 'texto-pergunta', texto);
      li.append(p);
      conversa.append(li);
      return li;
    }

    /** Uma linha de fonte, montada nó a nó — nunca por marcação em string. */
    function itemDeFonte(cit, indice) {
      const li = el('li');
      li.id = `fonte-${indice}-${cit.marcadores[0]}`;
      // marcadores extras da mesma fonte precisam de âncora própria, senão
      // [S2] apontando para uma fonte compartilhada não rola para lugar nenhum
      for (const n of cit.marcadores.slice(1)) {
        const alvo = el('span');
        alvo.id = `fonte-${indice}-${n}`;
        li.append(alvo);
      }
      li.append(el('span', 'marcas', cit.marcadores.map((n) => `[S${n}]`).join('') + ' '));

      const meta = [cit.nome, cit.rotulo, dataBr(cit.data)].filter(Boolean).join(' — ');
      li.append(el('span', 'fonte-meta', meta + (cit.ts ? `, ${cit.ts}` : '') + ' '));

      if (cit.url) {
        const a = el('a', 'link-fonte', 'abrir a fonte ↗');
        a.href = cit.url;
        a.target = '_blank';
        a.rel = 'noopener noreferrer nofollow';
        li.append(a);
      } else {
        li.append(el('span', 'fonte-meta', '(sem endereço registrado)'));
      }

      const ressalva = el('span', 'ressalva');
      if (cit.estatuto === 3) {
        ressalva.classList.add('nao-conferido');
        ressalva.textContent = '⚠ transcrição/legenda automática — pode conter erros; confira na fonte';
      } else if (cit.estatuto === 4) {
        ressalva.textContent = '✓ áudio conferido por uma segunda transcrição';
      } else if (cit.estatuto === 1) {
        ressalva.textContent = 'análise do eleicoes.ai — produzida por IA e identificada como tal';
      } else if (cit.estatuto_rotulo) {
        ressalva.textContent = cit.estatuto_rotulo;
      }
      if (ressalva.textContent) li.append(ressalva);
      return li;
    }

    async function copia(texto, botao, dono) {
      const original = botao.textContent;
      try {
        await navigator.clipboard.writeText(texto);
        botao.textContent = 'Copiado ✓';
        setTimeout(() => { botao.textContent = original; }, 1800);
      } catch {
        // área de transferência bloqueada (http, permissão negada, navegador
        // antigo): em vez de falhar em silêncio, entrega o texto selecionável
        let caixa = dono.querySelector('.copia-manual');
        if (!caixa) {
          caixa = el('div', 'copia-manual');
          caixa.append(el('p', null, 'Não consegui usar a área de transferência. Selecione e copie:'));
          caixa.append(el('textarea'));
          dono.append(caixa);
        }
        const area = caixa.querySelector('textarea');
        area.value = texto;
        area.select();
      }
    }

    function botao(rotulo, aoClicar, { secundario = true } = {}) {
      const b = el('button', `botao${secundario ? ' secundario' : ''}`, rotulo);
      b.type = 'button';
      b.addEventListener('click', aoClicar);
      return b;
    }

    /**
     * A barra de compartilhamento de um resultado.
     *
     * O endereço é a ROTA PÚBLICA da resposta guardada
     * (`/resposta/<compartilhamento_id>`): curta, estável e resolvida pelo
     * serviço que produziu o texto. Fragmento `#r=` continua sendo LIDO — link
     * antigo que já circula não pode morrer —, mas não se emite mais nenhum:
     * carregar a resposta inteira dentro da URL só se justificava enquanto não
     * havia onde guardá-la, e o preço era um link enorme e não autenticado.
     *
     * E a barra de endereço NÃO muda: a conversa corrente vive na home. Trocar
     * o endereço pela rota da resposta faria o recarregar e o "voltar" caírem
     * numa página avulsa, que não é a conversa que está na tela.
     */
    function barraDeCompartilhar(resultado, rotuloEstado) {
      const barra = el('div', 'barra-compartilhar');
      barra.setAttribute('aria-label', 'Compartilhar este resultado');

      const url = urlDeCompartilhamento(location.origin, resultado);
      const comum = { ...resultado, url, estado: rotuloEstado };

      if (navigator.share) {
        barra.append(botao('Compartilhar', async () => {
          try {
            await navigator.share(payloadWebShare(comum));
          } catch { /* cancelado pelo usuário: não é erro */ }
        }));
      }

      barra.append(botao('Copiar texto', (ev) => copia(textoCompleto(comum), ev.currentTarget, barra)));
      barra.append(botao('Copiar Markdown', (ev) => copia(markdownCompleto(comum), ev.currentTarget, barra)));

      const zap = el('a', 'botao secundario', 'WhatsApp');
      zap.href = linkWhatsApp(resumoLegivel(comum));
      zap.target = '_blank';
      zap.rel = 'noopener noreferrer';
      barra.append(zap);

      if (url) {
        barra.append(botao('Copiar link', (ev) => copia(url, ev.currentTarget, barra)));
      } else {
        // sem identificador não se inventa endereço: um link para uma resposta
        // que o serviço não guardou abriria 404 na cara de quem o recebeu, e
        // voltar ao fragmento devolveria um endereço não autenticado com cara
        // de endereço do site. Dizer que não há link é a saída honesta.
        const desativado = el('button', 'botao secundario', 'Link indisponível');
        desativado.type = 'button';
        desativado.disabled = true;
        barra.append(desativado);
        barra.append(el('p', 'nota-permalink',
          'Esta resposta não tem endereço próprio no eleicoes.ai — ela não foi guardada pelo '
          + 'serviço de evidências. Copiar o texto, copiar o Markdown e o WhatsApp continuam '
          + 'funcionando, e levam a pergunta e as fontes junto.'));
      }
      return barra;
    }

    function adicionaResposta(resultado, { viaFallback = false, compartilhado = false } = {}) {
      turnos += 1;
      const indice = turnos;
      const li = el('li', 'turno turno-resposta');
      const artigo = el('article');
      artigo.setAttribute('aria-label', `Resposta ${indice}`);

      if (compartilhado) {
        // dizer só "reconstruído do endereço" seria pouco: quem monta o endereço
        // escolhe o texto. O aviso precisa recusar explicitamente a procedência,
        // senão o permalink vira carimbo de autenticidade que ele não tem.
        artigo.append(el('p', 'aviso-turno',
          'Resultado reconstruído a partir de um link compartilhado. O texto abaixo vem do '
          + 'próprio endereço, não do serviço de evidências: ele NÃO é autenticado, pode ter '
          + 'sido alterado por quem montou o link e não deve ser tratado como publicação '
          + 'oficial. Confira cada fonte citada, ou refaça a pergunta abaixo.'));
      }

      const corpo = el('div', 'resposta-corpo');
      // `nivelBase: 1` rebaixa os títulos da resposta: `##` da API vira <h3>,
      // abaixo do <h1> da página e do <h2> da pergunta. Título de resposta
      // competindo com o da página quebra a navegação por cabeçalho no leitor
      // de tela.
      corpo.append(criaElementos(analisaMarkdown(resultado.texto), document, {
        nivelBase: 1,
        ancora: (n) => `#fonte-${indice}-${n}`,
      }));
      artigo.append(corpo);

      if (resultado.citacoes.length) {
        const sec = el('section', 'fontes');
        sec.append(el('h3', null, `Fontes citadas (${resultado.citacoes.length})`));
        const ol = el('ol');
        for (const cit of resultado.citacoes) ol.append(itemDeFonte(cit, indice));
        sec.append(ol);
        artigo.append(sec);
      } else {
        artigo.append(el('p', 'aviso-turno',
          'Esta resposta não trouxe nenhuma fonte citada. Sem citação não há evidência '
          + 'verificável: trate o texto como indisponibilidade, não como registro.'));
      }

      const est = estadoDaResposta(resultado);
      const rodape = el('div', 'rodape-resposta');
      if (resultado.rodape) {
        // "/metodologia" no texto do rodapé vira link para a página
        const p = el('p');
        const partes = String(resultado.rodape).split('/metodologia');
        partes.forEach((parte, i) => {
          if (i > 0) {
            const a = el('a', null, '/metodologia');
            a.href = '/metodologia';
            p.append(a);
          }
          if (parte) p.append(document.createTextNode(parte));
        });
        rodape.append(p);
      }
      artigo.append(rodape);

      li.append(artigo);
      conversa.append(li);

      artigo.append(barraDeCompartilhar(resultado, est.rotulo));
      return li;
    }

    function mostraErro(erro, perguntaRecusada) {
      const codigo = erro instanceof ErroConversa ? erro.codigo : 'desconhecido';
      mostraEstado(erro.message || 'Não foi possível responder agora.', { erro: true });
      if (codigo === 'sem-followup' && perguntaRecusada) {
        estado.append(botao('Enviar como nova pergunta', () => {
          reinicia();
          envia(perguntaRecusada);
        }));
      }
    }

    // -------------------------------------------------------------- fluxo

    function reinicia() {
      // primeiro a sessão: reiniciar ABORTA o que estiver em voo. Sem isso a
      // resposta da conversa anterior chegava depois e era anexada aqui, sem a
      // pergunta que a gerou.
      sessao.reinicia();
      turnos = 0;
      conversa.textContent = '';
      escondeEstado();
      enviar.disabled = false;
      nova.hidden = true;
      sugestoes.hidden = false;
      history.replaceState(null, '', location.pathname);
    }

    async function envia(texto) {
      const conteudo = String(texto ?? '').trim();
      if (!conteudo) return;

      sugestoes.hidden = true;
      nova.hidden = false;
      entrada.value = '';
      enviar.disabled = true;
      mostraEstado('Procurando no acervo e escrevendo a resposta…', { cancelavel: true });

      const r = await sessao.envia(conteudo, { aoPerguntar: adicionaPergunta });

      // época vencida: a conversa foi reiniciada ou já há outra pergunta em voo.
      // Quem reiniciou já arrumou a tela; desenhar aqui seria pôr resposta velha
      // em conversa nova.
      if (r.estado === 'obsoleto') return;

      enviar.disabled = false;
      if (r.estado === 'cancelado') {
        escondeEstado();
      } else if (r.estado === 'erro') {
        mostraErro(r.erro, r.perguntaRecusada);
      } else if (r.estado === 'ok') {
        escondeEstado();
        const li = adicionaResposta(r.resultado, { viaFallback: r.resultado.viaFallback });
        // a primeira resposta guardada vira a página desta conversa: o endereço
        // passa a ser /?resposta=<id> e o resto da conversa acontece nele
        const pagina = caminhoPagina(r.resultado.compartilhamento_id);
        if (pagina && !new URLSearchParams(location.search).get(PARAMETRO_PAGINA)) {
          history.replaceState(null, '', pagina);
        }
        li.scrollIntoView({ block: 'start', behavior: 'smooth' });
      }
      entrada.focus();
    }

    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      envia(entrada.value);
    });

    entrada.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter' && !ev.shiftKey && !ev.isComposing) {
        ev.preventDefault();
        form.requestSubmit();
      }
    });

    cancelar.addEventListener('click', () => sessao.cancela());

    nova.addEventListener('click', () => {
      reinicia();
      entrada.focus();
    });

    // as sugestões continuam sendo links reais (`/?q=…`): sem JavaScript elas
    // abrem a home com a pergunta; com JavaScript, disparam ali mesmo
    sugestoes.addEventListener('click', (ev) => {
      const alvo = ev.target.closest('.sugestao');
      if (!alvo) return;
      ev.preventDefault();
      envia(alvo.dataset.pergunta);
    });

    // ------------------------------------------------------ abertura da página

    (async () => {
      const compartilhado = await estadoDoFragmento(location.hash);
      if (compartilhado) {
        sugestoes.hidden = true;
        nova.hidden = false;
        if (compartilhado.pergunta) adicionaPergunta(compartilhado.pergunta);
        // o conteúdo do fragmento NÃO entra no histórico da sessão: quem monta
        // o link escolheria, com isso, o que o serviço recebe como turno
        // `assistant` na pergunta seguinte. O que veio da URL é para LER; a
        // próxima pergunta começa uma conversa de verdade.
        adicionaResposta(compartilhado, { compartilhado: true });
        return;
      }
      if (location.hash.startsWith('#r=')) {
        mostraEstado('Este link de resultado está incompleto ou foi truncado ao ser colado. '
          + 'Peça o link de novo, ou faça a pergunta abaixo.', { erro: true });
      }
      const parametros = new URLSearchParams(location.search);
      // /?resposta=<id>: a página de uma conversa. A pergunta e a resposta vêm
      // do armazém do serviço — iguais para todo mundo — e a conversa segue daqui.
      const idPagina = parametros.get(PARAMETRO_PAGINA);
      if (idPagina) {
        mostraEstado('Abrindo a resposta compartilhada…');
        try {
          const guardada = await carregaResposta(idPagina, { apiBase: chat.dataset.api });
          escondeEstado();
          if (!guardada) {
            mostraEstado('Esta resposta não foi encontrada. Faça a pergunta abaixo.', { erro: true });
            return;
          }
          sugestoes.hidden = true;
          nova.hidden = false;
          if (guardada.pergunta) adicionaPergunta(guardada.pergunta);
          adicionaResposta(guardada);
          sessao.retoma({ pergunta: guardada.pergunta, texto: guardada.texto });
        } catch (erro) {
          mostraErro(erro);
        }
        return;
      }
      const q = parametros.get('q');
      if (q) envia(q);
    })();
  </script>
</Base>
