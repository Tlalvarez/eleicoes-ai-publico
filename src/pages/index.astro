---
import Base from '../layouts/Base.astro';
import { leDados } from '../lib/dados.mjs';
import { candidatosDaHome } from '../lib/home.mjs';
import Chat from '../components/Chat.astro';
import imagens from '../data/imagens-candidatos.json';
import { urlCandidaturaTse } from '../lib/tse.mjs';

// os dados saem do MANIFESTO da geração ativa (data/current.json),
// nunca de um caminho fixo: itens, acervo e índice de pesquisa
// precisam ser sempre da MESMA geração
const resumo = leDados('itens', 'resumo.json');

// Os cards saem do resumo gerado pelo harness: uma home que citasse cinco
// nomes escritos à mão quebraria a cobertura simétrica logo na primeira página.
const candidatos = candidatosDaHome(resumo);

// os mesmos cards da página /candidato: retrato com manifesto de direitos,
// contagem de itens e crédito — cobertura simétrica, nenhum nome escrito à mão
const imagensPorSlug = new Map(imagens.candidates.map((imagem) => [imagem.candidate_slug, imagem]));
const cards = candidatos.map(({ slug, nome }) => {
  const imagem = imagensPorSlug.get(slug);
  if (!imagem) throw new Error(`Retrato sem manifesto de direitos: ${slug}`);
  // retrato e nome levam à conversa só sobre este candidato (/presidente/<slug>);
  // abaixo, o link para a página OFICIAL da candidatura no TSE. Candidato sem
  // identificador derruba o build — link para lugar nenhum é cobertura assimétrica
  return { slug, nome, ...resumo.candidatos[slug], imagem, tse: urlCandidaturaTse(slug) };
});

// Endereço do serviço de evidências. Sem `PUBLIC_PESQUISA_API`, o padrão é a
// MESMA ORIGEM ('') — o cliente pede `/api/conversa` relativo, e quem publica
// põe o serviço atrás do mesmo domínio.
//
// O padrão anterior era `http://localhost:8765`, e ele chegou ao `dist/`: um
// build público assim manda o navegador do VISITANTE procurar o serviço na
// máquina dele, e antes disso é barrado como conteúdo misto dentro de https.
// Localhost só sobrevive em desenvolvimento, onde o `astro dev` roda noutra
// porta que o serviço. Os dois lados são cobrados por gate:
// scripts/checa-home-fonte.mjs (origem) e scripts/checa-home-dist.mjs (build).
const apiBase = import.meta.env.PUBLIC_PESQUISA_API
  ?? (import.meta.env.DEV ? 'http://localhost:8765' : '');
---
<Base title="Eleições 2026 - Pergunte à IA sobre os candidatos">
  <div class="hero-home">
    <p class="sobretitulo">Eleições gerais de 2026</p>
    <h1>Pergunte à IA sobre os candidatos</h1>
    <p class="lead">
      Reunimos neste site apenas <strong>materiais oficiais</strong> e <strong>citações diretas</strong> dos candidatos
      publicadas nos últimos cinco anos. Nosso objetivo é oferecer informações que possam ser
      atribuídas com segurança a cada candidato, reduzindo o risco de desinformação e ajudando
      você a fazer uma escolha mais consciente na hora de votar.
    </p>
  </div>

  <Chat apiBase={apiBase} />

  <section class="secao-catalogo">
  <h2>Candidatos a presidente</h2>
  <ul class="grade-candidatos">
    {cards.map((c) => (
      <li class="cartao-candidato">
        <a class="retrato-link" href={`/presidente/${c.slug}`}
          title={`Conversar com a IA sobre ${c.nome}`}>
          <img
            src={c.imagem.image_path}
            width="161"
            height="225"
            loading="lazy"
            alt=""
          />
          <span class="nome-candidato">{c.nome}</span>
        </a>
        <p class="link-tse">
          <a href={c.tse} target="_blank" rel="noopener noreferrer">Ver no TSE ↗</a>
        </p>
        <p class="credito-retrato">
          Foto: {c.imagem.public_credit} ·
          {c.imagem.license_url
            ? <a href={c.imagem.license_url} target="_blank" rel="noopener noreferrer">{c.imagem.license}</a>
            : c.imagem.license}
        </p>
      </li>
    ))}
  </ul>
  <p class="depois-da-faixa">
    Clique no candidato para conversar com a IA só sobre ele. O link do TSE abre a página
    oficial da candidatura (DivulgaCandContas), em nova aba.
  </p>
  </section>

  <style>
    .hero-home { margin-bottom: 1.6rem; }
    .hero-home .lead { max-width: none; }
    .sobretitulo {
      margin: 0 0 .6rem;
      color: var(--acento);
      font-size: .79rem;
      font-weight: 800;
      letter-spacing: .13em;
      text-transform: uppercase;
    }
    .depois-da-faixa { margin-top: 1rem; }
    /* os mesmos cards da página /candidato */
    .grade-candidatos {
      display: grid;
      grid-template-columns: repeat(auto-fill, 161px);
      justify-content: start;
      gap: 1rem;
      padding: 0;
      margin: 1.5rem 0;
      list-style: none;
    }
    .cartao-candidato {
      overflow: hidden;
      display: flex;
      flex-direction: column;
      min-width: 0;
      border: 1px solid var(--linha);
      border-radius: var(--raio);
      background: var(--cartao);
      box-shadow: var(--sombra-leve);
    }
    .retrato-link {
      color: var(--tinta);
      text-decoration: none;
    }
    .retrato-link img {
      display: block;
      width: 100%;
      margin: 0;
      aspect-ratio: 161 / 225;
      object-fit: cover;
      background: var(--realce);
    }
    .nome-candidato {
      display: block;
      padding: .8rem 1rem .25rem;
      font-family: var(--fonte-titulo);
      font-size: 1.08rem;
      font-weight: 750;
      line-height: 1.2;
    }
    .retrato-link:hover .nome-candidato { color: var(--acento); text-decoration: underline; }
    .link-tse {
      flex: 1;
      margin: 0;
      padding: .25rem 1rem .75rem;
      font-size: .86rem;
    }
    .link-tse a { color: var(--acento); font-weight: 600; }
    .credito-retrato {
      margin: 0;
      padding: .65rem 1rem .8rem;
      border-top: 1px solid var(--linha);
      color: var(--tinta-suave);
      font-size: .7rem;
      line-height: 1.35;
    }
  </style>

</Base>
