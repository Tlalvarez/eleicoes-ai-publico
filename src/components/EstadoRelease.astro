---
/**
 * O estado de publicação dos dados, dito na cara da página.
 *
 * Nesta branch o site lê uma exportação local do harness e um catálogo
 * preparado à mão: não há release publicada nem Inspection. Um site cuja tese
 * é proveniência não pode chamar isso de "Acervo Oficial" — o aviso não é
 * disclaimer de rodapé, é informação de primeira ordem, e por isso aparece
 * antes do conteúdo.
 *
 * O rótulo NÃO é escrito aqui: ele vem do portão em src/lib/release.mjs, que
 * só devolve "oficial" com geração, `release_id` e `release_status`
 * declarados. Texto de interface não pode ser capaz de afirmar oficialidade
 * por conta própria.
 */
import { estadoDoSite } from '../lib/release.mjs';
import { leManifesto } from '../lib/dados.mjs';

const { detalheExtra = '' } = Astro.props;
const estado = estadoDoSite(leManifesto());
---
<aside class="estado-release" aria-label="Estado de publicação dos dados">
  <span class="marca" aria-hidden="true">{estado.oficial ? '◆' : '◇'}</span>
  <p>
    <strong>{estado.rotulo}</strong><br />
    <span class="detalhe">
      {estado.oficial
        ? `Dados publicados: ${estado.detalhe}.`
        : 'Os dados desta página vêm de uma exportação de trabalho do coletor, sem manifesto de geração publicado e sem passar por Inspection. Servem para avaliação interna do produto — não têm estatuto de release oficial e não devem ser citados como se tivessem.'}
      {detalheExtra && ` ${detalheExtra}`}
    </span>
  </p>
</aside>
