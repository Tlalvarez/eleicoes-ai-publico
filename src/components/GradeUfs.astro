---
/**
 * As 27 unidades da federação de um cargo por estado. Sem JavaScript: um link
 * por UF. Quem tem comparação pronta diz quantas propostas foram comparadas;
 * quem não tem, "em preparação" — a rota existe nos dois casos.
 */
import { UFS, caminhoUf } from '../lib/cargos.mjs';
import { resumoDoEscopo } from '../lib/comparacao-dados.mjs';
const { cargo } = Astro.props;
const linhas = UFS.map((uf) => ({ uf, propostas: resumoDoEscopo(cargo.slug, uf.sigla).reduce((n, r) => n + r.propostas, 0) }));
---
<nav aria-label={`Estados — ${cargo.nome}`}>
  <ul class="grade-ufs">
    {linhas.map(({ uf, propostas }) => (
      <li>
        <a class="uf" href={caminhoUf(cargo, uf)} data-evento="uf_aberta" data-destino={uf.sigla.toLowerCase()}>
          <span class="sigla" aria-hidden="true">{uf.sigla}</span>
          <span class="nome">{uf.nome}<span class="estado">{propostas ? `${propostas.toLocaleString('pt-BR')} propostas` : 'em preparação'}</span></span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .grade-ufs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
    gap: .6rem;
    padding: 0;
    margin: 1rem 0 1.5rem;
    list-style: none;
  }
  .uf {
    display: flex;
    align-items: center;
    gap: .7rem;
    min-height: var(--alvo);
    padding: .55rem .8rem;
    border: 1px solid var(--linha);
    border-radius: var(--raio);
    background: var(--cartao);
    box-shadow: var(--sombra-leve);
    color: var(--tinta);
    text-decoration: none;
  }
  .uf:hover { border-color: var(--azul-claro); background: var(--realce); }
  .uf:hover .nome { text-decoration: underline; }
  .sigla {
    flex: 0 0 2.6rem;
    text-align: center;
    font-family: var(--fonte-titulo);
    font-weight: 800;
    font-size: .95rem;
    letter-spacing: .04em;
    color: var(--acento-forte);
    background: var(--realce);
    border-radius: 6px;
    padding: .25rem 0;
  }
  .nome { font-weight: 600; line-height: 1.2; }
  .estado { display: block; font-size: .78rem; font-weight: 400; color: var(--tinta-suave); }
</style>
