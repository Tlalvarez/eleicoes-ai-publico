---
import IconeFluxo from './IconeFluxo.astro';
/**
 * O fluxograma editorial, em linhas que se leem como frase (pedido do Thiago,
 * 15/09/2026): ATOR + AÇÃO + objeto que ENTRA + "em" + objeto que SAI.
 *
 * Os nomes dos objetos são para quem nunca ouviu os nossos termos (3ª decisão
 * do Thiago, 15/09): nada de "bloco", "rótulo", "posição" ou "núcleo". O nome
 * tem de bastar — a linha de detalhe é opcional e só existe onde há uma regra
 * dura que o nome não cabe (o corte de 5%, a definição de oposição).
 *
 * Cada OBJETO é declarado UMA vez em `objetos` — nome, ícone e cor — e as
 * linhas só o referenciam pela chave. O portão no fim do frontmatter quebra o
 * BUILD se a corrente se romper: a saída de uma linha tem de ser a entrada da
 * seguinte.
 *
 * Rigor antes de estilo: cada linha existe no pipeline real da v3 (harness):
 * congela_entradas → fatia_blocos → rotula_blocos → confere_rotulos →
 * compara_tema → varredura_tema → cruza_tema → confere_discordancias →
 * confere_fidelidade → aplica_fidelidade → funde_proprias → tira_espelhos →
 * exporta_site. Mudou o pipeline, muda aqui.
 */
const objetos = {
  'programa': { nome: 'Programa de governo', icone: 'programa' },
  'pdf': { nome: 'PDF no site do TSE', icone: 'pdf' },
  'texto': { nome: 'Texto do programa', icone: 'texto' },
  'trechos': { nome: 'Parágrafos numerados', icone: 'trechos' },
  'trechos-tema': { nome: 'Parágrafos por tema', icone: 'trechos-tema' },
  'propostas': { nome: 'Propostas com quem propõe', icone: 'propostas' },
  'validas': { nome: 'Propostas com fonte conferida', icone: 'conferidas' },
  'oposicoes': { nome: 'Propostas com contrário conferido', icone: 'contra' },
  'conferidas': { nome: 'Propostas com apoio conferido', icone: 'conferidas' },
  'comparacao': { nome: 'Comparação pronta', icone: 'comparacao' },
  'pagina': { nome: 'Página no site', icone: 'pagina' },
};

const linhas = [
  { quem: 'candidato', ator: 'Candidato', icone: 'candidato', acao: 'registra', de: 'programa', para: 'pdf' },
  { quem: 'codigo', ator: 'Código', icone: 'codigo', acao: 'extrai', de: 'pdf', para: 'texto',
    detalhe: 'O texto fica congelado: as etapas seguintes usam sempre essa versão.' },
  { quem: 'codigo', ator: 'Código', icone: 'codigo', acao: 'corta', de: 'texto', para: 'trechos',
    detalhe: 'Os parágrafos remontam o texto inteiro, sem sobra nem repetição.' },
  { quem: 'modelo', ator: 'Modelo de IA', icone: 'modelo', acao: 'separa por tema', de: 'trechos', para: 'trechos-tema',
    detalhe: 'Um parágrafo pode receber mais de um tema, e a página usa o principal. Parágrafo sem tema válido fica como perdido, e perdido acima de 5% reprova a rodada.' },
  { quem: 'modelo', ator: 'Modelo de IA', icone: 'modelo', acao: 'compara e redige', de: 'trechos-tema', para: 'propostas',
    detalhe: 'Os seis programas entram juntos. O modelo aponta os parágrafos que sustentam cada posição.' },
  { quem: 'codigo', ator: 'Código', icone: 'codigo', acao: 'confere a fonte de', de: 'propostas', para: 'validas',
    detalhe: 'O parágrafo citado tem de existir e ser daquele candidato. O modelo não inventa uma fonte.' },
  { quem: 'cego', ator: 'Modelo às cegas', icone: 'cego', acao: 'julga os contrários de', de: 'validas', para: 'oposicoes',
    detalhe: 'Contrário é rejeitar, revogar ou decidir o inverso. Outro caminho para o mesmo fim não é.' },
  { quem: 'cego', ator: 'Modelo às cegas', icone: 'cego', acao: 'julga o apoio de', de: 'oposicoes', para: 'conferidas',
    detalhe: 'Quem apoia só uma parte da frase ganha uma proposta própria com o seu detalhe.' },
  { quem: 'codigo', ator: 'Código', icone: 'codigo', acao: 'junta as repetidas de', de: 'conferidas', para: 'comparacao',
    detalhe: 'Saem também as propostas espelhadas, como "permanecer no BRICS" e "retirar o Brasil do BRICS".' },
  // "revisa por amostragem" e não "revisa": a pessoa lê os pontos onde um erro pesa mais,
  // não proposta por proposta. Dizer só "revisa" prometia conferência que não existe
  // (decisão do Thiago, 16/09). O que entra na amostra está em /metodologia#quem-faz.
  { quem: 'pessoa', ator: 'Pessoa', icone: 'pessoa', acao: 'revisa por amostragem e publica', de: 'comparacao', para: 'pagina' },
];

// portão de build: objeto inexistente ou corrente quebrada param a construção, não a leitura
for (const [i, l] of linhas.entries()) {
  for (const chave of [l.de, l.para]) {
    if (!objetos[chave]) throw new Error(`DiagramaEditorial: a linha ${i + 1} usa o objeto "${chave}", que não existe`);
  }
  if (i > 0 && linhas[i - 1].para !== l.de) {
    throw new Error(`DiagramaEditorial: a corrente quebrou entre as linhas ${i} e ${i + 1}: `
      + `sai "${linhas[i - 1].para}" e entra "${l.de}"`);
  }
}

---

<figure class="fluxo-editorial" aria-labelledby="passo-a-passo">

  <ol class="cadeia">
    {linhas.map((l) => (
      <li class={`passo ${l.quem}`}>
        <p class="frase">
          <span class="ator">
            <span class="avatar" aria-hidden="true"><IconeFluxo nome={l.icone} tamanho={20} /></span>
            <span class="nome-ator">{l.ator}</span>
          </span>
          <span class="acao">{l.acao}</span>
          <span class={`objeto obj-${l.de}`}>
            <span class="figura" aria-hidden="true"><IconeFluxo nome={objetos[l.de].icone} tamanho={18} /></span>
            <span class="nome-objeto">{objetos[l.de].nome}</span>
          </span>
          <span class="em">em</span>
          <span class={`objeto obj-${l.para}`}>
            <span class="figura" aria-hidden="true"><IconeFluxo nome={objetos[l.para].icone} tamanho={18} /></span>
            <span class="nome-objeto">{objetos[l.para].nome}</span>
          </span>
        </p>
        {l.detalhe && <p class="detalhe">{l.detalhe}</p>}
      </li>
    ))}
  </ol>

  <p class="nota">
    Usamos um único modelo de IA, o Claude Opus 5, da Anthropic. Ele recebe as mesmas instruções
    para todo tema e todo candidato. Cada proposta fica ligada aos parágrafos de onde saiu, e você
    pode voltar do cartão ao texto do programa.
  </p>
</figure>

<style>
  .fluxo-editorial { margin: 1.5rem 0 2rem; padding: 0; }


  /* a cadeia: uma linha por transformação, numerada, com a frase em cima e o detalhe embaixo */
  .fluxo-editorial .cadeia { list-style: none; counter-reset: passo; margin: 0; padding: 0;
    border: 1px solid var(--linha-forte); border-radius: var(--raio); background: var(--cartao); overflow: hidden; }
  .fluxo-editorial .passo { counter-increment: passo; position: relative; padding: .85rem 1rem .85rem 2.6rem;
    border-top: 1px solid var(--linha); }
  .fluxo-editorial .passo:first-child { border-top: 0; }
  .fluxo-editorial .passo::before { content: counter(passo); position: absolute; left: .8rem; top: .95rem;
    font-size: .8rem; font-weight: 800; color: var(--tinta-suave); }
  .fluxo-editorial .passo::after { content: ''; position: absolute; left: 1.1rem; top: 2.1rem; bottom: -.1rem;
    border-left: 2px solid var(--linha); }
  .fluxo-editorial .passo:last-child::after { display: none; }

  .fluxo-editorial .frase { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem .5rem; margin: 0; }
  .fluxo-editorial .frase + .detalhe { margin-top: .35rem; }
  .fluxo-editorial .ator { display: inline-flex; align-items: center; gap: .4rem; }
  .fluxo-editorial .avatar { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%;
    border: 2px solid var(--linha-forte); background: var(--cartao); color: var(--tinta-suave); flex: none; }
  .fluxo-editorial .passo.modelo .avatar { border-color: var(--azul-claro); color: var(--azul); }
  .fluxo-editorial .passo.cego .avatar { border-color: var(--atencao); color: var(--atencao); }
  .fluxo-editorial .passo.pessoa .avatar { border-color: var(--verde); color: var(--verde); }
  .fluxo-editorial .nome-ator { font-size: .78rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase;
    color: var(--tinta-suave); }
  .fluxo-editorial .passo.modelo .nome-ator { color: var(--azul); }
  .fluxo-editorial .passo.cego .nome-ator { color: var(--atencao); }
  .fluxo-editorial .passo.pessoa .nome-ator { color: var(--verde); }
  .fluxo-editorial .acao { font-weight: 800; font-size: 1rem; color: var(--tinta); }
  .fluxo-editorial .em { font-size: .9rem; color: var(--tinta-suave); }

  /* OBJETOS: cada objeto tem a SUA cor, e ela não muda de etapa para etapa (decisão do Thiago,
     15/09). O nome fica sempre em tinta escura: a cor identifica, mas não carrega informação
     sozinha — quem não distingue as cores lê o mesmo nome e o mesmo ícone. */
  .fluxo-editorial .objeto { display: inline-flex; align-items: center; gap: .4rem; padding: .3rem .6rem .3rem .35rem;
    border-radius: 999px; border: 1px solid var(--obj-borda, var(--linha-forte)); background: var(--obj-fundo, var(--papel)); }
  .fluxo-editorial .objeto .figura { display: grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: 50%;
    background: var(--cartao); color: var(--obj-tinta, var(--azul)); flex: none; }
  .fluxo-editorial .nome-objeto { font-size: .9rem; font-weight: 600; color: var(--tinta); }

  .fluxo-editorial .obj-programa     { --obj-fundo: #eceae2; --obj-borda: #c6c0b2; --obj-tinta: #6b6255; }
  .fluxo-editorial .obj-pdf          { --obj-fundo: #fbe4d8; --obj-borda: #e6a684; --obj-tinta: #a8501f; }
  .fluxo-editorial .obj-texto        { --obj-fundo: #ece5f8; --obj-borda: #b6a4e2; --obj-tinta: #5b3fa0; }
  .fluxo-editorial .obj-trechos      { --obj-fundo: #dcecf9; --obj-borda: #8bbfe6; --obj-tinta: #1d5fa0; }
  .fluxo-editorial .obj-trechos-tema { --obj-fundo: #d6eeea; --obj-borda: #7cc7be; --obj-tinta: #14706a; }
  .fluxo-editorial .obj-propostas    { --obj-fundo: #e2e4f7; --obj-borda: #aeb0e0; --obj-tinta: #4a41a8; }
  .fluxo-editorial .obj-validas      { --obj-fundo: #e3efd9; --obj-borda: #a5cd8b; --obj-tinta: #3d7a22; }
  .fluxo-editorial .obj-oposicoes    { --obj-fundo: #f7e2dd; --obj-borda: #dfa696; --obj-tinta: #a5442a; }
  .fluxo-editorial .obj-conferidas   { --obj-fundo: #f7ecc9; --obj-borda: #dcc274; --obj-tinta: #7a5c12; }
  .fluxo-editorial .obj-comparacao   { --obj-fundo: #f8e1ec; --obj-borda: #e0a4c0; --obj-tinta: #93356a; }
  .fluxo-editorial .obj-pagina       { --obj-fundo: #dde3ef; --obj-borda: #98abc8; --obj-tinta: #17365d; }

  .fluxo-editorial .detalhe { margin: 0; font-size: .9rem; color: var(--tinta-suave); }

  @media (max-width: 34rem) {
    .fluxo-editorial .passo { padding: .8rem .75rem .8rem 2.1rem; }
    .fluxo-editorial .passo::before { left: .55rem; }
    .fluxo-editorial .passo::after { left: .85rem; }
    .fluxo-editorial .avatar { width: 1.7rem; height: 1.7rem; }
    .fluxo-editorial .nome-objeto { font-size: .85rem; }
  }
</style>
