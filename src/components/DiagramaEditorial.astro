---
/**
 * O diagrama editorial como fluxo de objetos: o que entra, quem transforma,
 * o que sai. Pedido do Thiago (15/09/2026) no lugar da lista de etapas: cada
 * caixa é um OBJETO (PDF, texto, trechos, propostas, página) e cada faixa é um
 * ATOR aplicando uma AÇÃO que muda o objeto de estado.
 *
 * Espelha o pipeline real da v3 (harness): congela_entradas → fatia_blocos →
 * rotula_blocos → confere_rotulos → compara_tema → varredura_tema → cruza_tema
 * → confere_discordancias → confere_fidelidade → aplica_fidelidade →
 * funde_proprias → tira_espelhos → exporta_site. Mudou o pipeline, muda aqui.
 *
 * `fluxo` alterna objeto e transformação, sempre nesta ordem: o objeto de cima
 * é a entrada da faixa seguinte, e o objeto de baixo é a saída dela.
 */
const fluxo = [
  { tipo: 'objeto', nome: 'Programa de governo', detalhe: 'O documento escrito pela campanha, do tamanho que ela quiser: de 20 a 1.742 páginas.' },
  {
    tipo: 'acao', ator: 'Candidato', quem: 'candidato', acao: 'registra',
    detalhe: 'Ao pedir o registro da candidatura, o candidato entrega o programa ao TSE. É este documento — e nenhum outro — que comparamos.',
  },
  { tipo: 'objeto', nome: 'PDF público no site do TSE', detalhe: 'Um arquivo por candidatura, com o carimbo do TSE.' },
  {
    tipo: 'acao', ator: 'Código de extração', quem: 'codigo', acao: 'extrai o texto',
    detalhe: 'O PDF vira texto, página a página, e é congelado: guardamos a impressão digital (sha256) do arquivo e do texto. Tudo o que vem depois aponta para essa versão.',
  },
  { tipo: 'objeto', nome: 'Programa em texto, congelado', detalhe: 'O texto inteiro, com o número da página de cada parte.' },
  {
    tipo: 'acao', ator: 'Código', quem: 'codigo', acao: 'fatia em trechos',
    detalhe: 'O corte segue fronteiras gerais: seção, página, linha em branco, item de lista, fim de frase. Juntando os trechos de volta, sai o texto inteiro — sem sobra nem repetição.',
  },
  { tipo: 'objeto', nome: 'Trechos numerados', detalhe: 'Centenas por programa. O número é o endereço do trecho, e é por ele que tudo se cita depois.' },
  {
    tipo: 'acao', ator: 'Modelo de IA', quem: 'modelo', acao: 'etiqueta por tema',
    detalhe: 'O modelo recebe os trechos numerados e devolve o tema de cada um — economia, saúde, segurança… Ele devolve número e tema, nunca o texto. O código confere: trecho sem tema válido fica marcado como perdido, e perdido acima de 5% reprova a rodada.',
  },
  { tipo: 'objeto', nome: 'Trechos com tema', detalhe: 'Agora dá para juntar, num tema só, o que os seis programas dizem sobre ele.' },
  {
    tipo: 'acao', ator: 'Modelo de IA', quem: 'modelo', acao: 'compara e escreve as propostas',
    detalhe: 'Os trechos daquele tema, de todos os candidatos, entram juntos numa leitura só. O modelo escreve cada proposta uma vez, em frase neutra, e diz, para cada candidato, se ele propõe, propõe o contrário ou não cita — apontando os trechos em que se baseou. Duas passadas de repescagem recuperam o que ficou de fora.',
  },
  { tipo: 'objeto', nome: 'Propostas com posições', detalhe: 'Cada proposta com a lista de quem propõe, quem se opõe e quem não cita, e os trechos de cada um.' },
  {
    tipo: 'acao', ator: 'Código', quem: 'codigo', acao: 'confere as citações',
    detalhe: 'Cada trecho citado tem de existir, ser daquele candidato e estar na entrada da leitura. O que não passa é recusado — o modelo não tem como inventar uma fonte.',
  },
  {
    tipo: 'acao', ator: 'Modelo às cegas', quem: 'juiz', acao: 'julga as oposições',
    detalhe: 'Entra cada posição marcada como "propõe o contrário", sem nome de candidato. Rejeitar, revogar ou fazer o inverso da mesma decisão é oposição; propor outro caminho para o mesmo fim, não — e essa posição cai para "não cita".',
  },
  {
    tipo: 'acao', ator: 'Modelo às cegas', quem: 'juiz', acao: 'julga a sustentação',
    detalhe: 'Entra cada candidato de uma proposta compartilhada, com os trechos dele e sem nome. Sustenta: fica. Sustenta só em parte: a proposta passa a ter só o núcleo comum, e o detalhe dele vira uma proposta própria. Não sustenta: sai — e só vira "propõe o contrário" se duas leituras cegas confirmarem.',
  },
  { tipo: 'objeto', nome: 'Propostas conferidas', detalhe: 'Mais as propostas próprias que nasceram de quem sustentava só parte da frase.' },
  {
    tipo: 'acao', ator: 'Código', quem: 'codigo', acao: 'funde e tira espelhos',
    detalhe: 'Propostas próprias quase iguais do mesmo candidato viram uma. Propostas espelhadas — o mesmo assunto escrito duas vezes, uma de cada lado, como "permanecer no BRICS" e "retirar o Brasil do BRICS" — viram uma, depois de uma leitura cega confirmar que decidem a mesma coisa.',
  },
  { tipo: 'objeto', nome: 'Comparação da página', detalhe: 'A lista final de propostas daquele tema, com as posições e os trechos de origem.' },
  {
    tipo: 'acao', ator: 'Pessoa', quem: 'pessoa', acao: 'revisa e publica',
    detalhe: 'Uma pessoa lê a página pronta e decide o que entra. É aqui que ficam as escolhas editoriais que o código não toma sozinho.',
  },
  { tipo: 'objeto', nome: 'Página no site', detalhe: 'Os cartões que você lê, os trechos que abrem ao toque e a busca daquele tema.', fim: true },
];

const legendas = {
  candidato: 'Candidato',
  codigo: 'Código',
  modelo: 'Modelo de IA',
  juiz: 'Modelo lendo às cegas',
  pessoa: 'Pessoa',
};
---

<figure class="fluxo-editorial" aria-labelledby="diagrama-editorial-titulo">
  <figcaption id="diagrama-editorial-titulo">
    O que entra, quem transforma, o que sai — do programa registrado à página que você lê.
  </figcaption>
  <p class="legenda">
    <span class="rotulo-legenda">Quem transforma:</span>
    {Object.entries(legendas).map(([k, v]) => (
      <span class={`chip ${k}`}>{v}</span>
    ))}
  </p>

  <ol class="cadeia">
    {fluxo.map((p) => (p.tipo === 'objeto' ? (
      <li class={`objeto${p.fim ? ' fim' : ''}`}>
        <span class="tag">Objeto</span>
        <h3>{p.nome}</h3>
        <p>{p.detalhe}</p>
      </li>
    ) : (
      <li class={`transformacao ${p.quem}`}>
        <span class="seta" aria-hidden="true"></span>
        <div class="corpo">
          <p class="cabeca"><span class={`chip ${p.quem}`}>{p.ator}</span><span class="acao">{p.acao}</span></p>
          <p>{p.detalhe}</p>
        </div>
      </li>
    )))}
  </ol>

  <p class="nota">
    O modelo é sempre o mesmo (Claude Opus 5, da Anthropic), e as instruções dadas a ele são
    gerais: não citam tema, caso nem candidato. Nenhuma transformação apaga a anterior — cada
    proposta continua ligada aos trechos de onde saiu, e por isso dá para voltar do cartão ao
    parágrafo do programa.
  </p>
</figure>

<style>
  .fluxo-editorial { margin: 1.5rem 0 2rem; padding: 0; }
  .fluxo-editorial figcaption { font-weight: 700; color: var(--tinta); margin-bottom: .6rem; }
  .fluxo-editorial .legenda { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin: 0 0 1rem; }
  .fluxo-editorial .rotulo-legenda { font-size: .75rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
    color: var(--tinta-suave); margin-right: .2rem; }
  .fluxo-editorial .chip { font-size: .72rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase;
    padding: .2rem .5rem; border-radius: 999px; border: 1px solid var(--linha); color: var(--tinta-suave); background: var(--cartao); }
  .fluxo-editorial .chip.candidato { border-color: var(--linha-forte); color: var(--tinta); }
  .fluxo-editorial .chip.codigo { border-color: var(--linha-forte); }
  .fluxo-editorial .chip.modelo { border-color: var(--azul-claro); color: var(--azul); }
  .fluxo-editorial .chip.juiz { border-color: var(--atencao); color: var(--atencao); }
  .fluxo-editorial .chip.pessoa { border-color: var(--verde); color: var(--verde); }

  .fluxo-editorial .cadeia { list-style: none; margin: 0; padding: 0; }

  /* objeto: o estado em que a informação está */
  .fluxo-editorial .objeto { background: var(--cartao); border: 1px solid var(--linha-forte); border-left: 4px solid var(--azul);
    border-radius: var(--raio); padding: .7rem .9rem; }
  .fluxo-editorial .objeto.fim { border-left-color: var(--verde); }
  .fluxo-editorial .objeto .tag { display: inline-block; font-size: .65rem; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; color: var(--tinta-suave); }
  .fluxo-editorial .objeto h3 { margin: .1rem 0 .25rem; font-size: 1rem; line-height: 1.3; }
  .fluxo-editorial .objeto p { margin: 0; font-size: .92rem; color: var(--tinta-suave); }

  /* transformação: quem pega o objeto de cima e devolve o de baixo */
  .fluxo-editorial .transformacao { position: relative; display: grid; grid-template-columns: 2rem 1fr; gap: .6rem;
    padding: .45rem 0 .45rem .2rem; }
  .fluxo-editorial .transformacao .seta { position: relative; width: 2rem; }
  /* a linha desce do objeto de cima até o de baixo, com a ponta da seta no fim */
  .fluxo-editorial .transformacao .seta::before { content: ''; position: absolute; left: .85rem; top: -.45rem; bottom: -.45rem;
    border-left: 2px solid var(--linha-forte); }
  .fluxo-editorial .transformacao .seta::after { content: ''; position: absolute; left: .45rem; bottom: -.5rem;
    border: .35rem solid transparent; border-top-color: var(--linha-forte); }
  .fluxo-editorial .transformacao .corpo { border-left: 3px solid var(--linha); padding: .1rem 0 .1rem .7rem; }
  .fluxo-editorial .transformacao.modelo .corpo { border-left-color: var(--azul-claro); }
  .fluxo-editorial .transformacao.juiz .corpo { border-left-color: var(--atencao); }
  .fluxo-editorial .transformacao.pessoa .corpo { border-left-color: var(--verde); }
  .fluxo-editorial .transformacao .cabeca { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; margin: 0 0 .25rem; }
  .fluxo-editorial .transformacao .acao { font-weight: 800; color: var(--tinta); }
  .fluxo-editorial .transformacao .corpo p:last-child { margin: 0; font-size: .92rem; }

  .fluxo-editorial .nota { margin: 1rem 0 0; font-size: .9rem; color: var(--tinta-suave); }

  @media (max-width: 30rem) {
    .fluxo-editorial .transformacao { grid-template-columns: 1.2rem 1fr; gap: .45rem; }
    .fluxo-editorial .transformacao .seta { width: 1.2rem; }
    .fluxo-editorial .transformacao .seta::before { left: .5rem; }
    .fluxo-editorial .transformacao .seta::after { left: .1rem; }
  }
</style>
