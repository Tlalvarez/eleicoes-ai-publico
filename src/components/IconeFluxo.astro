---
/**
 * Os ícones do fluxo editorial (`DiagramaEditorial.astro`): objetos e atores.
 *
 * SVG literal, no traço da lupa da busca (viewBox 24, `currentColor`,
 * `aria-hidden`): o gate de render seguro proíbe `set:html`, e o de
 * acessibilidade cobra `alt` em `<img>` — ícone que é decoração entra como
 * SVG inline e some para o leitor de tela. O significado está sempre no texto
 * ao lado, nunca no desenho.
 */
interface Props { nome: string; tamanho?: number; }
const { nome, tamanho = 28 } = Astro.props;
const t = String(tamanho);
---
{nome === 'programa' && (
  <svg width={t} height={t} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M5 3h10l4 4v14H5z" /><path d="M15 3v4h4" /><path d="M8 11h8M8 14.5h8M8 18h5" />
  </svg>
)}
{nome === 'pdf' && (
