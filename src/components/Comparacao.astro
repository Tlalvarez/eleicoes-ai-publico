---
/**
 * A comparação de um tema: uma coluna por candidato (ordem alfabética), cada
 * proposta escrita UMA vez, esticada sobre as colunas de quem a faz. Quem
 * propõe o contrário aparece em vermelho na própria coluna, dentro da mesma
 * caixa de temas. Tocar na proposta abre os trechos do programa de cada candidato.
 *
 * O layout (seções por número de candidatos, posição e largura de cada
 * cartão) sai de src/lib/comparacao.mjs — a MESMA função que o navegador
 * usa quando a pessoa tira ou põe um candidato na comparação (`?c=`).
 * O servidor desenha os cartões; o navegador só os reposiciona.
 *
 * Sem cor por candidato, sem placar, sem id à vista. Trechos e notas vêm do
 * JSON exportado pelo harness (data/comparacao/), nunca de texto livre aqui.
 */
import Busca from './Busca.astro';
import { layout, contagens } from '../lib/comparacao.mjs';
import { indiceDeContestacoes } from '../lib/correcoes.mjs';

// Toda página segue o mesmo padrão desde 16/09 (decisão do Thiago): quem dá o título é a
// página, e o componente desenha só a matriz — sem trilha e sem abertura própria. `naHome`
// diz apenas para onde "limpar a busca" volta, porque o endereço do primeiro tema
// redireciona para a home.
const { dados, base, paginas, naHome = false } = Astro.props;
const voltaDoFiltro = naHome ? '/' : `${base}/${dados.pagina}`;
// o escopo da busca é o mesmo da página: 'presidente' ou 'governador/sp'
const escopoBusca = base.replace(/^\//, '');
// dados: o JSON da página; base: '/presidente' ou '/governador/sp';
// paginas: as páginas do escopo com comparação pronta
const ordem = dados.candidatos.map((c) => c.slug);
const porSlug = Object.fromEntries(dados.candidatos.map((c) => [c.slug, c]));
// selo "contestado pelo candidato" (§3.6 da revisão jurídica, 16/09): o pedido de
// campanha registrado em data/correcoes.json viaja DENTRO da proposta, porque a
// mesma função de layout roda no navegador, onde não há arquivo para ler.
const escopoCorrecoes = base.replace(/^\//, '');
const contestacoes = indiceDeContestacoes();
const propostas = dados.propostas.map((p) => {
  const ids = contestacoes[`${escopoCorrecoes}|${dados.pagina}|${p.id}`];
  return ids ? { ...p, contestacoes: ids } : p;
});
const porId = Object.fromEntries(propostas.map((p) => [p.id, p]));
const L = layout(propostas, ordem);
const numeros = contagens(propostas, ordem);

// o que o navegador precisa para reposicionar e abrir trechos; `<` escapado
// para o JSON nunca fechar a tag em que viaja
const embutido = JSON.stringify({
  tema: dados.pagina,
  candidatos: dados.candidatos,
  propostas,
  blocos: dados.blocos,
}).replace(/</g, '\\u003c');

const estiloCartao = (c) => `grid-column:${c.ini + 1} / span ${c.largura};--l:${c.largura}`;
const estiloConteudo = (c) => `grid-column:${c.a + 1} / span ${c.b - c.a + 1}`;
---
<div class="comparacao" style={`--n:${ordem.length}`} data-tema={dados.pagina}>
  {/* 1px que não ocupa espaço: quando ele sai da tela, a faixa grudou no alto. É o
      único jeito de o CSS saber que está congelada — não existe seletor de "sticky
      preso" — e é disso que depende mostrar lá só o filtro que gerou a matriz. */}
  <div class="sentinela-faixa" aria-hidden="true"></div>
  <div class="faixa-temas">
    {/* Decisão do Thiago (16/09): a busca volta a ser um link acima do seletor, e a caixa
        só aparece ao clicar. Na faixa congelada fica SÓ o controle que gerou a matriz —
        o seletor, quando veio do tema; a caixa, quando veio da busca. */}
    <a href="/busca" class="abrir-busca" role="button" aria-expanded="false" aria-controls="busca-no-tema">Realizar busca</a>
    <div id="busca-no-tema" class="busca-na-faixa" hidden>
      <Busca compacta semRotulo escopo={escopoBusca} />
    </div>
    <span class="rotulo-tema" id="rotulo-tema">Tema</span>
    <details class="seletor-tema" data-base={base}>
      <summary aria-labelledby="rotulo-tema tema-atual"><span id="tema-atual">{dados.nome}</span></summary>
      <ul class="lista-temas" role="list">
        {paginas.map((p) => (
          <li>
            <a href={`${base}/${p.id}`} data-tema={p.id} aria-current={p.id === dados.pagina ? 'page' : undefined}
              data-evento="tema_aberto" data-origem="faixa">{p.nome}</a>
          </li>
        ))}
      </ul>
    </details>
    <span class="dica-tema" aria-hidden="true">{paginas.length} temas</span>
  </div>

  <div class="filtro-busca" role="status" hidden>
    <p class="filtro-texto"></p>
    <p class="filtro-acoes"><a class="limpar" href={voltaDoFiltro}>Limpar a busca e ver o tema inteiro</a></p>
  </div>

  <div class="seletor" role="group" aria-label="Candidatos na comparação">
    <p class="seletor-rotulo">Comparar:</p>
    <ul>
      {dados.candidatos.map((c) => (
        <li>
          <button type="button" class="chip" aria-pressed="true" data-slug={c.slug}>
            {c.foto && <img src={c.foto} width="22" height="30" alt="" loading="lazy" />}
            <span>{c.nome}</span>
          </button>
        </li>
      ))}
    </ul>
    <p class="contagem" aria-live="polite">
      <span class="contagem-n">{L.total}</span> <span class="contagem-rotulo">{L.total === 1 ? 'proposta' : 'propostas'}</span>
    </p>
  </div>

  {/* Em pé, a comparação mostra uma coluna — o contrário do que o site faz. O aviso de
      rodapé era fácil de ignorar, então virou tela cheia (Thiago, 16/09), com o desenho
      de um telefone girando. A saída discreta existe de propósito: quem está com a
      rotação travada no aparelho não pode ficar do lado de fora do site. */}
  <div class="gire" role="dialog" aria-modal="true" aria-labelledby="gire-titulo" hidden>
    <div class="gire-caixa">
      <div class="gire-desenho" aria-hidden="true">
        <svg class="gire-seta" viewBox="0 0 132 64" width="132" height="64" focusable="false">
          <path d="M10 52 A 58 58 0 0 1 122 52" fill="none" stroke="currentColor" stroke-width="3"
            stroke-linecap="round" stroke-dasharray="5 8" />
          <path d="M112 38 L122 52 L107 56" fill="none" stroke="currentColor" stroke-width="3"
            stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <div class="gire-telefone"><span class="gire-tela"></span></div>
      </div>
      <h2 id="gire-titulo">Gire o celular</h2>
      <p>A comparação põe os candidatos lado a lado. Em pé cabe uma coluna; deitado, cabem todas.</p>
      <button type="button" class="gire-saida">Continuar em pé mesmo assim</button>
    </div>
  </div>

  <div class="quadro">
    <div class="cabecalho-colunas">
      <div class="grade">
        {dados.candidatos.map((c) => (
          <div class="candidato" data-slug={c.slug}>
            {c.foto && <img src={c.foto} width="36" height="50" alt="" />}
            <span>
              <span class="nome">{c.nome}</span>
              <span class="ficha">{c.partido}{c.numero ? ` · nº ${c.numero}` : ''} · {numeros[c.slug].propoe} propostas</span>
            </span>
          </div>
        ))}
      </div>
    </div>
    <div class="rolagem" tabindex="0" aria-label="Propostas por candidato; role para o lado para ver todas as colunas">
      <div class="grade grade-propostas">
        {L.linhas.map((linha) => {
          if (linha.tipo === 'secao') return <h2>{linha.rotulo}</h2>;
          if (linha.tipo === 'subtema') return <h3 class="assunto">{linha.rotulo}</h3>;
          if (linha.tipo === 'pilhas') {
            return linha.pilhas.map((pilha, i) => (
              <div class={`pilha${pilha.length ? '' : ' vazia'}`} style={`grid-column:${i + 1}`}>
                {pilha.map((c) => {
                  const p = porId[c.id];
                  return (
                    <button type="button" class={`proposta${c.comContra ? ' com-contra' : ''}`} data-p={c.id} data-k={c.chave} style={estiloCartao({ ...c, ini: 0 })}>
                      <span class="colunas" style={`grid-template-columns:repeat(${c.largura},1fr)`}>
                        {c.colunas.map((k) => <span class={k === 'concorda' ? undefined : k}></span>)}
                      </span>
                      <span class="conteudo" style={estiloConteudo(c)}>
                        <span class="texto">{p.proposta}</span>
                      </span>
                      {c.metas && (
                        <span class="metas" style={`grid-template-columns:repeat(${c.largura},1fr)`}>
                          {c.metas.map((m) => (
                            <span class="meta" style={`grid-column:${m.col + 1}`}>
                              <b>Meta no programa</b>
                              {m.itens.map((x) => <span class="item">{x.rotulo}: {x.valor}</span>)}
                            </span>
                          ))}
                        </span>
                      )}
                      {c.contestada && (
                        <span class="selo-contestado">contestado pelo candidato</span>
                      )}
                    </button>
                  );
                })}
              </div>
            ));
          }
          const p = porId[linha.id];
          return (
            <button type="button" class={`proposta${linha.comContra ? ' com-contra' : ''}${linha.lacuna ? ' com-lacuna' : ''}`} data-p={linha.id} data-k={linha.chave} style={estiloCartao(linha)}>
              <span class="colunas" style={`grid-template-columns:repeat(${linha.largura},1fr)`}>
                {linha.colunas.map((k) => <span class={k === 'concorda' ? undefined : k}></span>)}
              </span>
              <span class="conteudo" style={estiloConteudo(linha)}>
                <span class="texto">{p.proposta}</span>
              </span>
              {linha.metas && (
                <span class="metas" style={`grid-template-columns:repeat(${linha.largura},1fr)`}>
                  {linha.metas.map((m) => (
                    <span class="meta" style={`grid-column:${m.col + 1}`}>
                      <b>Meta no programa</b>
                      {m.itens.map((x) => <span class="item">{x.rotulo}: {x.valor}</span>)}
                    </span>
                  ))}
                </span>
              )}
              {linha.contestada && (
                <span class="selo-contestado">contestado pelo candidato</span>
              )}
            </button>
          );
        })}
      </div>
    </div>
  </div>


  <dialog class="trechos" aria-labelledby="trechos-titulo">
    <div class="topo">
      <p class="subtema"></p>
      <button type="button" class="botao secundario fechar">Fechar</button>
    </div>
    <h2 id="trechos-titulo"></h2>
    <div class="corpo"></div>
  </dialog>
</div>

<script is:inline define:vars={{ json: embutido }}>
  globalThis.__comparacao = JSON.parse(json);
</script>

<script>
  import { layout, selecaoDaUrl, urlDaSelecao } from '../lib/comparacao.mjs';
  import { buscaPorPagina } from '../lib/busca-navegador.mjs';
  import { contextoDoCaminho, defineContextoPadrao, medir } from '../lib/medicao.mjs';

  const raiz = document.querySelector('.comparacao');

  // O contexto (cargo, uf, pagina) acompanha todo evento, e quem o define é o
  // rodapé do layout. No Astro 7 os <script> saem na ordem de definição, então o
  // deste componente roda ANTES — e um evento emitido na carga sairia sem
  // dimensão nenhuma. Foi o que aconteceu com `girar_pedido`: chegou ao PostHog
  // com props vazias (medido em 17/09). `defineContextoPadrao` cede a quem já
  // tiver definido, então chamar aqui não disputa com o layout.
  defineContextoPadrao(contextoDoCaminho(location.pathname));
  const D = globalThis.__comparacao;
  if (raiz && D) {
    const ordem = D.candidatos.map((c) => c.slug);
    const C = Object.fromEntries(D.candidatos.map((c) => [c.slug, c]));
    const porId = Object.fromEntries(D.propostas.map((p) => [p.id, p]));
    const nomeDoTema = Object.fromEntries([...raiz.querySelectorAll('.lista-temas a')].map((a) => [a.dataset.tema, a.textContent]));
    const grade = raiz.querySelector('.grade-propostas');
    const cabecalho = raiz.querySelector('.cabecalho-colunas');
    const rolagem = raiz.querySelector('.rolagem');
    const contagem = raiz.querySelector('.contagem-n');
    const contagemRotulo = raiz.querySelector('.contagem-rotulo');
    const chips = [...raiz.querySelectorAll('.seletor button[data-slug]')];
    // os cartões desenhados no build; o navegador só os reposiciona
    // uma proposta pode virar mais de um cartão (candidatos não adjacentes): o mapa é por chave
    const cartoes = new Map([...grade.querySelectorAll('button.proposta')].map((b) => [b.dataset.k, b]));
    const el = (tag, classe, texto) => {
      const e = document.createElement(tag);
      if (classe) e.className = classe;
      if (texto !== undefined) e.textContent = texto;
      return e;
    };

    // ---------------------------------------------------------- a seleção
    let selecao = ordem.slice();
    // `?q=`: a busca cruza temas — a matriz passa a mostrar só o que fala do
    // assunto, deste tema e dos outros (propostas trazidas dos JSONs das outras
    // páginas, com id `tema/pid`); null = o tema inteiro
    let filtro = null;
    let externas = [];
    const consulta = (new URLSearchParams(location.search).get('q') || '').trim();
    const propostasVisiveis = () => (filtro ? [...D.propostas, ...externas].filter((p) => filtro.has(p.id)) : D.propostas);

    function criaCartao(p, chave) {
      const b = el('button', 'proposta');
      b.type = 'button';
      b.dataset.p = p.id;
      b.dataset.k = chave;
      b.append(el('span', 'colunas'));
      const conteudo = el('span', 'conteudo');
      conteudo.append(el('span', 'texto', p.proposta));
      b.append(conteudo);
      b.append(el('span', 'metas'));
      cartoes.set(chave, b);
      return b;
    }

    function posiciona(c) {
      const b = cartoes.get(c.chave) ?? criaCartao(porId[c.id], c.chave);
      b.style.gridColumn = `${c.ini + 1} / span ${c.largura}`;
      b.style.setProperty('--l', String(c.largura));
      b.classList.toggle('com-contra', c.comContra);
      b.classList.toggle('com-lacuna', Boolean(c.lacuna));
      const colunas = b.querySelector('.colunas');
      colunas.style.gridTemplateColumns = `repeat(${c.largura},1fr)`;
      colunas.replaceChildren(...c.colunas.map((k) => el('span', k === 'concorda' ? '' : k)));
      b.querySelector('.conteudo').style.gridColumn = `${c.a + 1} / span ${c.b - c.a + 1}`;
      let metas = b.querySelector('.metas');
      if (!metas) {
        // o cartão veio do HTML construído, que só emite a faixa quando há meta
        metas = el('span', 'metas');
        b.append(metas);
      }
      metas.style.gridTemplateColumns = `repeat(${c.largura},1fr)`;
      metas.replaceChildren(...(c.metas ?? []).map((m) => {
        const cel = el('span', 'meta');
        cel.style.gridColumn = String(m.col + 1);
        cel.append(el('b', '', 'Meta no programa'));
        for (const x of m.itens) cel.append(el('span', 'item', `${x.rotulo}: ${x.valor}`));
        return cel;
      }));
      metas.hidden = !(c.metas && c.metas.length);
      let selo = b.querySelector('.selo-contestado');
      if (!selo) {
        selo = el('span', 'selo-contestado', 'contestado pelo candidato');
        b.append(selo);
      }
      selo.hidden = !(c.contestada && c.contestada.length);
      return b;
    }

    function aplica(sel) {
      selecao = sel;
      raiz.style.setProperty('--n', String(sel.length));
      for (const cel of cabecalho.querySelectorAll('.candidato')) cel.hidden = !sel.includes(cel.dataset.slug);
      for (const ch of chips) ch.setAttribute('aria-pressed', String(sel.includes(ch.dataset.slug)));
      const L = layout(propostasVisiveis(), sel);
      const frag = document.createDocumentFragment();
      for (const linha of L.linhas) {
        if (linha.tipo === 'secao') frag.append(el('h2', '', linha.rotulo));
        else if (linha.tipo === 'subtema') frag.append(el('h3', 'assunto', linha.rotulo));
        else if (linha.tipo === 'pilhas') {
          linha.pilhas.forEach((pilha, i) => {
            const d = el('div', pilha.length ? 'pilha' : 'pilha vazia');
            d.style.gridColumn = String(i + 1);
            for (const c of pilha) d.append(posiciona({ ...c, ini: 0 }));
            frag.append(d);
          });
        } else frag.append(posiciona(linha));
      }
      grade.replaceChildren(frag);
      if (contagem) contagem.textContent = String(L.total);
      if (contagemRotulo) contagemRotulo.textContent = L.total === 1 ? 'proposta' : 'propostas';
    }

    // `?c=lula,romeu-zema`: a vírgula fica legível, o endereço é para ser compartilhado
    // `?c=` (os candidatos) acompanha a troca de tema; `?q=` não — o resultado
    // da busca já é de todos os temas, e trocar de tema é sair dela
    const sufixo = (sel, comBusca = false) => {
      const partes = [];
      if (comBusca && consulta) partes.push(`q=${encodeURIComponent(consulta)}`);
      const c = urlDaSelecao(sel, ordem);
      if (c) partes.push(`c=${c}`);
      return partes.length ? `?${partes.join('&')}` : '';
    };

    function guardaNaUrl(sel) {
      history.replaceState(null, '', location.pathname + sufixo(sel, true) + location.hash);
      atualizaLinksDeTema();
    }

    // o menu de temas é uma lista de links (funciona sem JavaScript); os links
    // levam a seleção de candidatos junto, e o menu fecha ao clicar fora ou com Esc
    const seletorTema = raiz.querySelector('.seletor-tema');
    const linksDeTema = [...raiz.querySelectorAll('.lista-temas a')];
    function atualizaLinksDeTema() {
      for (const a of linksDeTema) a.href = `${seletorTema.dataset.base}/${a.dataset.tema}${sufixo(selecao)}`;
    }
    if (seletorTema) {
      document.addEventListener('click', (e) => {
        if (seletorTema.open && e.target instanceof Node && !seletorTema.contains(e.target)) seletorTema.open = false;
      });
      seletorTema.addEventListener('keydown', (e) => { if (e.key === 'Escape') { seletorTema.open = false; seletorTema.querySelector('summary')?.focus(); } });
    }

    for (const ch of chips) {
      ch.addEventListener('click', () => {
        const slug = ch.dataset.slug;
        let sel;
        if (selecao.includes(slug)) {
          if (selecao.length === 1) return; // sempre há ao menos um candidato na tela
          sel = selecao.filter((s) => s !== slug);
        } else sel = ordem.filter((s) => selecao.includes(s) || s === slug);
        aplica(sel);
        guardaNaUrl(sel);
        medir('comparacao_filtrada', { tema: D.tema, candidatos: sel.length });
      });
    }

    const daUrl = selecaoDaUrl(new URLSearchParams(location.search).get('c'), ordem);
    if (daUrl) { aplica(daUrl); atualizaLinksDeTema(); }

    // a matriz filtrada pela busca: cruza todos os temas do escopo. As
    // propostas dos outros temas vêm dos JSONs publicados em /comparacao/, com
    // os blocos citados (o painel de trechos precisa deles)
    const barra = raiz.querySelector('.filtro-busca');
    const titulo = raiz.querySelector('.abertura h1');
    const lead = raiz.querySelector('.abertura .lead');
    async function carregaTema(escopo, pagina) {
      const r = await fetch(`/comparacao/${escopo}/${pagina}.json`);
      if (!r.ok) throw new Error(`${pagina}: ${r.status}`);
      return r.json();
    }
    async function filtraPelaBusca(q) {
      const escopo = raiz.querySelector('.seletor-tema')?.dataset.base?.replace(/^\//, '') || 'presidente';
      // o resultado é de todos os temas: a caixa de temas sai da tela, senão
      // parece que só este tema está sendo mostrado
      raiz.classList.add('em-busca');
      barra.querySelector('.filtro-texto').textContent = `Buscando "${q}"…`;
      barra.hidden = false;
      let r;
      try { r = await buscaPorPagina(escopo, q); } catch {
        barra.querySelector('.filtro-texto').textContent = 'Não consegui carregar a busca; mostrando o tema inteiro.';
        return;
      }
      const ids = new Set();
      externas = [];
      for (const g of r.porPagina) {
        if (g.pagina === D.tema) {
          for (const pid of g.ids) ids.add(pid);
          continue;
        }
        let outro;
        try { outro = await carregaTema(escopo, g.pagina); } catch { continue; }
        const quer = new Set(g.ids);
        for (const p of outro.propostas) {
          if (!quer.has(p.id)) continue;
          const id = `${g.pagina}/${p.id}`;
          const copia = { ...p, id, subtema: `${g.nome} · ${p.subtema}`, tema: g.pagina };
          porId[id] = copia;
          externas.push(copia);
          ids.add(id);
        }
        // os blocos citados pelas propostas do outro tema, para o painel de trechos
        for (const [slug, bl] of Object.entries(outro.blocos ?? {})) {
          D.blocos[slug] = { ...(D.blocos[slug] ?? {}), ...bl };
        }
      }
      // as deste tema também ganham o nome do tema no cabeçalho, para a leitura ser uniforme
      for (const p of D.propostas) {
        if (ids.has(p.id) && !p.subtemaOriginal) { p.subtemaOriginal = p.subtema; p.subtema = `${nomeDoTema[D.tema] ?? D.tema} · ${p.subtema}`; }
      }
      filtro = ids;
      aplica(selecao);
      const n = ids.size;
      const temas = r.porPagina.length;
      // resgate por sentido: nenhuma palavra da consulta casou, e o vetor decidiu. Dizer isso
      // é obrigatório — resultado aproximado apresentado como certo engana mais do que o
      // "nenhuma proposta fala disso" que ele substitui (16/09).
      barra.querySelector('.filtro-texto').textContent = n
        ? (r.resgatado
          ? `Nenhuma proposta usa a palavra "${q}". Estas ${n > 1 ? `${n} falam` : 'fala'} de assunto parecido, em ${temas} tema${temas > 1 ? 's' : ''}.`
          : `${n} proposta${n > 1 ? 's' : ''} sobre "${q}" em ${temas} tema${temas > 1 ? 's' : ''}${r.modo === 'lexical' ? ' (busca por palavras; a busca por sentido está indisponível agora)' : ''}.`)
        : `Nenhuma proposta sobre "${q}".`;
      medir('busca_feita', { consulta: q, resultados: n, temas, modo: r.modo, direto: !r.semDireto, destino: D.tema });
      if (titulo) titulo.textContent = `"${q}": o que cada candidato propõe`;
      if (lead) lead.textContent = 'Resultado da busca em todos os temas. Uma proposta feita por mais de um candidato aparece uma vez, sobre as colunas de quem a faz. Toque para ler o trecho do programa.';
      document.title = `"${q}" · Busca · eleicoes.ai`;
    }
    if (consulta) filtraPelaBusca(consulta);

    // O link "Realizar busca" abre a caixa (decisão do Thiago, 16/09). Em modo de busca a
    // faixa continua congelada, mas mostra SÓ a caixa: o que fica no alto tem de ser o
    // controle que gerou a matriz — o seletor quando veio do tema, a caixa quando veio da busca.
    const abrir = raiz.querySelector('.abrir-busca');
    const caixaBusca = raiz.querySelector('.busca-na-faixa');
    const abreBusca = (foca) => {
      caixaBusca.hidden = false;
      abrir.setAttribute('aria-expanded', 'true');
      if (foca) caixaBusca.querySelector('input[name="q"]')?.focus();
    };
    abrir?.addEventListener('click', (ev) => {
      ev.preventDefault();
      if (caixaBusca.hidden) abreBusca(true);
      else { caixaBusca.hidden = true; abrir.setAttribute('aria-expanded', 'false'); }
    });
    // quem chega por um endereço de busca já vê a consulta no lugar congelado
    if (consulta) {
      abreBusca(false);
      const campoDaFaixa = caixaBusca.querySelector('input[name="q"]');
      if (campoDaFaixa && !campoDaFaixa.value) campoDaFaixa.value = consulta;
    }

    // Congelada, a faixa mostra SÓ o que está filtrando a matriz (Thiago, 16/09). A regra
    // já valia para a busca que filtrou; faltava o caso de a caixa estar apenas ABERTA e
    // vazia: aí o alto da tela ficava com link, caixa e seletor, e no celular a matriz só
    // começava depois dos três. A sentinela diz quando a faixa grudou; grudada e sem busca
    // ativa, o link e a caixa saem, e volta a caber o seletor sozinho.
    const sentinela = raiz.querySelector('.sentinela-faixa');
    if (sentinela && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        ([e]) => raiz.classList.toggle('grudada', !e.isIntersecting),
        { threshold: 0 },
      ).observe(sentinela);
    }

    // `#p=<id>`: a busca (e qualquer link) chega numa proposta; ela rola até
    // a tela, ganha destaque e o foco — se estiver na tela com a seleção atual
    function destaca() {
      const m = /^#p=([A-Za-z0-9_-]+)$/.exec(location.hash);
      if (!m) return;
      const b = grade.querySelector(`button.proposta[data-p="${CSS.escape(m[1])}"]`);
      if (!b) return;
      for (const outro of grade.querySelectorAll('.proposta.destaque')) outro.classList.remove('destaque');
      b.classList.add('destaque');
      b.scrollIntoView({ block: 'center' });
      b.focus({ preventScroll: true });
    }
    destaca();
    addEventListener('hashchange', destaca);

    // o cabeçalho congelado acompanha a rolagem lateral do corpo
    rolagem.addEventListener('scroll', () => { cabecalho.scrollLeft = rolagem.scrollLeft; }, { passive: true });

    // No celular em pé a matriz não cumpre o que promete: cabe uma coluna. Em vez do
    // aviso de rodapé, a tela inteira pede para girar, e sai sozinha quando o aparelho
    // gira. `pointer: coarse` limita isso a aparelho de toque — numa janela estreita de
    // computador, cobrir a tela seria estorvo, e lá a pessoa resolve alargando a janela.
    const gire = raiz.querySelector('.gire');
    const emPe = matchMedia('(orientation: portrait) and (max-width: 760px) and (pointer: coarse)');
    let seguiuEmPe = false;
    let girarMedido = false;
    const mostraGire = () => {
      const mostra = !seguiuEmPe && emPe.matches;
      gire.hidden = !mostra;
      // com a tela coberta, rolar o que está atrás é rolagem fantasma
      document.body.classList.toggle('sem-rolagem', mostra);
      // uma vez por página: girar e voltar não conta como dois pedidos
      if (mostra && !girarMedido) { girarMedido = true; medir('girar_pedido'); }
    };
    gire.querySelector('.gire-saida').addEventListener('click', () => {
      seguiuEmPe = true;
      medir('girar_dispensado');
      mostraGire();
    });
    emPe.addEventListener('change', mostraGire);
    mostraGire();

    // ---------------------------------------------------------- os trechos
    const dlg = raiz.querySelector('dialog.trechos');
    const corpo = dlg.querySelector('.corpo');
    let ultimo = null;

    // `pagina` é a folha do PDF (conferido contra pdf_pagina do índice de busca, 16/09), e a
    // rota do TSE serve application/pdf direto — então #page=N abre na página exata. O link
    // do chip prometia isso e não cumpria; agora cumpre.
    function linkTse(slug, texto, classe, pagina) {
      const a = el('a', classe, texto);
      a.href = pagina ? `${C[slug].tse}#page=${pagina}` : C[slug].tse;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.dataset.evento = 'tse_aberto';
      a.dataset.slug = slug;
      return a;
    }

    function abre(p) {
      dlg.querySelector('.subtema').textContent = p.subtema;
      dlg.querySelector('#trechos-titulo').textContent = p.proposta;
      const frag = document.createDocumentFragment();
      // §3.6 da revisão jurídica (16/09): o selo no cartão é só o aviso; o link para o
      // registro público vive aqui, porque o cartão inteiro é um botão e link dentro de
      // botão é HTML inválido. O pedido aparece tenha sido aceito ou recusado.
      if (p.contestacoes && p.contestacoes.length) {
        const aviso = el('p', 'contestado');
        aviso.append(document.createTextNode(
          p.contestacoes.length > 1
            ? 'Campanhas pediram correção nesta proposta. '
            : 'Uma campanha pediu correção nesta proposta. '));
        const a = el('a', '', 'Ver o pedido e a decisão no registro público');
        a.href = `/correcoes#pedido-${p.contestacoes[0]}`;
        aviso.append(a);
        frag.append(aviso);
      }
      for (const s of selecao) {
        const v = p.posicoes[s];
        if (!v) continue;
        frag.append(el('h3', '', C[s].nome + (v.posicao === 'discorda' ? ' · propõe o contrário' : '')));
        if (v.nota) frag.append(el('p', 'nota', v.nota));
        for (const n of v.blocos) {
          const b = (D.blocos[s] || {})[String(n)];
          if (!b) continue;
          const q = el('blockquote', '', `${b.texto} `);
          q.append(linkTse(s, `p. ${b.pagina}`, 'fonte-chip', b.pagina));
          frag.append(q);
        }
        const link = el('p', 'link-tse');
        link.append(linkTse(s, 'Ver o programa no TSE ↗', ''));
        frag.append(link);
      }
      corpo.replaceChildren(frag);
      dlg.showModal();
      medir('proposta_aberta', {
        tema: D.tema,
        candidatos: selecao.filter((s) => p.posicoes[s]?.posicao === 'concorda').length,
        com_contra: selecao.some((s) => p.posicoes[s]?.posicao === 'discorda'),
      });
    }

    grade.addEventListener('click', (e) => {
      const alvo = e.target instanceof Element ? e.target.closest('button[data-p]') : null;
      if (!alvo) return;
      ultimo = alvo;
      abre(porId[alvo.dataset.p]);
    });
    dlg.querySelector('.fechar').addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => { if (ultimo) ultimo.focus(); });
  }
</script>

<style is:global>
  /* A página da comparação. Tudo sob .comparacao, porque parte da estrutura
     é criada pelo navegador ao filtrar candidatos — estilo escopado não a alcançaria. */

  .comparacao { --faixa-altura: 3.3rem; }
  /* Em modo de busca a faixa NÃO some: ela troca de conteúdo. O que fica congelado no alto
     tem de ser o controle que gerou a matriz — o seletor de tema quando a pessoa escolheu
     um tema, a caixa de texto quando ela buscou. Antes os dois ficavam juntos, e a faixa
     inteira sumia durante a busca (decisão do Thiago, 16/09). */
  .comparacao.em-busca .rotulo-tema,
  .comparacao.em-busca .seletor-tema,
  .comparacao.em-busca .dica-tema,
  .comparacao.em-busca .abrir-busca { display: none; }
  .comparacao.em-busca .busca-na-faixa[hidden] { display: flex; }
  /* a sentinela mede o grude sem ocupar espaço nenhum no fluxo */
  .comparacao .sentinela-faixa { height: 1px; margin-bottom: -1px; }
  /* congelada e sem busca ativa: o link e a caixa (que pode estar aberta e vazia) saem de
     cena, porque nenhum dos dois está filtrando coisa alguma. Com busca ativa, em-busca
     acima já tira o seletor de tema. Em ambos os casos sobra uma fileira só, que é o que
     --faixa-altura promete ao cabeçalho de colunas grudado logo abaixo. */
  .comparacao.grudada:not(.em-busca) .abrir-busca,
  .comparacao.grudada:not(.em-busca) .busca-na-faixa { display: none; }
  /* min-height, não height: com o botão de busca na mesma linha, a faixa quebra em duas
     quando não cabe, e altura fixa cortaria a segunda (16/09). O --faixa-altura continua
     valendo como deslocamento do cabeçalho de colunas, que gruda logo abaixo. */
  /* a linha de baixo fica no meio do vão, não colada no seletor: sem padding, a borda
     encostava no seletor (0px) e os 16px de margem ficavam todos do lado dos chips
     (medido em 1200px, 16/09). Metade para cada lado — a soma não muda, e a matriz
     continua onde estava. */
  .comparacao .faixa-temas { position: sticky; top: 0; z-index: 20; min-height: var(--faixa-altura); margin: 0 0 .5rem; padding-bottom: .5rem;
    display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .6rem; background: var(--papel); border-bottom: 1px solid var(--linha); }
  /* na mesma linha, a busca fica na ponta direita; quando a faixa quebra, ela ocupa a
     linha inteira, e não fica pendurada na borda oposta (16/09) */
  /* a caixa acompanha a altura do seletor: o parágrafo de estado sai do fluxo, mas o
     formulário ainda carregava a altura dele e empurrava a faixa para 73px (16/09) */
  /* o link e a caixa ficam ACIMA do seletor, ocupando a própria linha (16/09) */
  .comparacao .abrir-busca { order: -1; flex: 1 1 100%; font-size: .92rem; font-weight: 600;
    color: var(--acento); text-decoration: underline; text-underline-offset: .18em;
    min-height: var(--alvo); display: inline-flex; align-items: center; cursor: pointer;
    background: none; border: 0; padding: 0; }
  .comparacao .busca-na-faixa { order: -1; flex: 1 1 100%; min-width: 13rem;
    align-self: flex-start; display: flex; flex-wrap: wrap; }
  .comparacao .busca-na-faixa[hidden] { display: none; }
  .comparacao .busca-na-faixa .busca-caixa { margin: 0; flex: 1 1 auto; min-width: 0; }
  /* o estado da busca OCUPA espaço, não flutua. Tirá-lo do fluxo para ganhar 8px de
     alinhamento fez a mensagem cair sobre os chips de candidato (16/09); ancorá-la logo
     abaixo da caixa não bastou, porque o que está abaixo são justamente os chips. A faixa
     cresce para acomodá-la, como já cresce quando o botão empilha. */
  .comparacao .busca-na-faixa .busca-estado:empty { display: none; }
  .comparacao .busca-na-faixa .busca-estado {
    flex: 1 1 100%; order: 9; margin: .1rem 0 0; min-height: 0; color: var(--tinta);
  }
  /* dentro da faixa, campo e lupa têm a altura do seletor (44px): o .campo do site tem
     49px por causa do padding, e cinco pixels a mais empurravam a faixa para 73px (16/09).
     Só aqui — nas outras páginas a caixa continua com a altura padrão. */
  .comparacao .busca-na-faixa .campo,
  .comparacao .busca-na-faixa .botao { min-height: 0; height: var(--alvo); }
  .comparacao .busca-na-faixa .campo { padding-block: 0; }
  /* a caixa sem rótulo ganha margem para respirar embaixo do título da página; dentro da
     faixa não há título acima dela, e essa margem desalinhava a caixa do seletor em 11px */
  .comparacao .busca-na-faixa .busca-caixa.sem-rotulo { margin-top: 0; }
  /* o parágrafo de estado é absoluto, mas segue filho do formulário: sem altura fixa, a
     caixa vira um bloco mais alto que o campo e a faixa centraliza o bloco, não o campo */
  .comparacao .busca-na-faixa .busca-caixa { display: flex; flex-wrap: wrap; }
  .comparacao .busca-na-faixa .linha { flex: 1 1 100%; height: var(--alvo); }

  .comparacao .rotulo-tema { font-size: .82rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--acento-forte); }
  /* o menu de temas é nosso (details + lista), não o <select> nativo: o
     popup do sistema saía com o dobro do tamanho no macOS e não se estiliza */
  .comparacao .seletor-tema { position: relative; flex: 0 1 26rem; min-width: 0; }
  .comparacao .seletor-tema summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: .6rem;
    min-height: var(--alvo); padding: .35rem .8rem; font-weight: 600; color: var(--tinta); background: var(--cartao);
    border: 1px solid var(--linha-forte); border-radius: 8px; cursor: pointer; user-select: none; }
  .comparacao .seletor-tema summary::-webkit-details-marker { display: none; }
  .comparacao .seletor-tema summary::after { content: ''; flex: none; width: .5rem; height: .5rem; margin-right: .1rem;
    border-right: 2px solid var(--acento-forte); border-bottom: 2px solid var(--acento-forte); transform: translateY(-.15rem) rotate(45deg); }
  .comparacao .seletor-tema[open] summary::after { transform: translateY(.15rem) rotate(-135deg); }
  .comparacao .seletor-tema summary:hover { border-color: var(--azul-claro); }
  .comparacao .seletor-tema summary:focus-visible { outline: 2px solid var(--acento); outline-offset: 2px; }
  .comparacao .lista-temas { position: absolute; left: 0; right: 0; top: calc(100% + .3rem); z-index: 30; margin: 0; padding: .3rem; list-style: none;
    max-height: min(60vh, 28rem); overflow-y: auto; background: var(--cartao); border: 1px solid var(--linha-forte); border-radius: 8px; box-shadow: var(--sombra); }
  .comparacao .lista-temas a { display: block; min-height: 2.4rem; padding: .45rem .7rem; border-radius: 6px; color: var(--tinta); text-decoration: none; font-size: .95rem; }
  .comparacao .lista-temas a:hover { background: var(--realce); }
  .comparacao .lista-temas a:focus-visible { background: var(--realce); outline: 2px solid var(--acento); outline-offset: -2px; }
  .comparacao .lista-temas a[aria-current='page'] { font-weight: 700; color: var(--acento-forte); background: var(--realce); }
  .comparacao .lista-temas a[aria-current='page']::before { content: '✓ '; }
  .comparacao .dica-tema { font-size: .82rem; color: var(--tinta-suave); white-space: nowrap; }

  /* O pedido para girar toma a tela inteira: em pé o site mostra um candidato de cada
     vez, que é o oposto de comparar. Azul-marinho cheio, como o cabeçalho — nada de
     cartão flutuante, que era justamente o que dava para ignorar. */
  .comparacao .gire { position: fixed; inset: 0; z-index: 100;
    display: flex; align-items: center; justify-content: center; padding: 2rem 1.5rem;
    background: var(--azul); color: var(--branco); text-align: center; }
  .comparacao .gire[hidden] { display: none; }
  .comparacao .gire-caixa { max-width: 21rem; }
  /* a cor é obrigatória: a folha pinta todo h1/h2 com --acento-forte, que é o MESMO
     azul-marinho do fundo daqui — sem esta linha o título some no próprio fundo
     (aconteceu na primeira versão, 16/09) */
  .comparacao .gire h2 { margin: 1.4rem 0 .6rem; font-family: var(--fonte-titulo);
    font-size: 1.75rem; font-weight: 800; letter-spacing: -.02em; color: var(--branco); }
  .comparacao .gire p { margin: 0 0 1.6rem; font-size: 1rem; line-height: 1.5; color: rgba(255, 255, 255, .86); }
  .comparacao .gire-saida { min-height: var(--alvo); padding: .5rem 1rem; font: inherit; font-size: .92rem;
    font-weight: 600; color: rgba(255, 255, 255, .78); background: none; border: 0;
    text-decoration: underline; text-underline-offset: .2em; cursor: pointer; }
  .comparacao .gire-saida:hover { color: var(--branco); }

  /* o desenho: um telefone que sai da vertical para a horizontal, e volta */
  .comparacao .gire-desenho { position: relative; display: grid; place-items: center; height: 200px; color: var(--amarelo); }
  .comparacao .gire-seta { position: absolute; top: 0; left: 50%; transform: translateX(-50%); opacity: .85; }
  .comparacao .gire-telefone { margin-top: 2.6rem; width: 84px; height: 148px;
    display: grid; place-items: center; border: 3px solid var(--branco); border-radius: 14px;
    animation: gira-o-telefone 3.4s ease-in-out infinite; }
  .comparacao .gire-tela { display: block; width: 60px; height: 110px; border-radius: 4px; background: rgba(255, 255, 255, .2); }
  @keyframes gira-o-telefone {
    0%, 20% { transform: rotate(0deg); }
    45%, 80% { transform: rotate(-90deg); }
    100% { transform: rotate(0deg); }
  }
  /* quem pede menos movimento vê o fim da história, não o começo: o telefone já deitado.
     A regra global encurta toda animação para .01ms, e sem `animation: none` a keyframe
     continuaria mandando no transform. */
  @media (prefers-reduced-motion: reduce) {
    .comparacao .gire-telefone { animation: none; transform: rotate(-90deg); }
  }


  .comparacao .abertura .lead { max-width: 52em; }

  .comparacao .seletor { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem .6rem; margin: 0 0 1rem; }
  .comparacao .seletor-rotulo, .comparacao .contagem { margin: 0; font-size: .88rem; color: var(--tinta-suave); }
  .comparacao .seletor ul { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0; padding: 0; list-style: none; }
  .comparacao .chip { display: inline-flex; align-items: center; gap: .45rem; min-height: var(--alvo); padding: .3rem .8rem .3rem .4rem;
    font: inherit; font-size: .9rem; font-weight: 600; color: var(--tinta); background: var(--cartao);
    border: 1px solid var(--linha); border-radius: 999px; cursor: pointer; }
  .comparacao .chip img { width: 22px; height: 30px; object-fit: cover; border-radius: 4px; background: var(--realce); }
  .comparacao .chip[aria-pressed='true'] { border-color: var(--acento-forte); background: var(--realce); box-shadow: inset 0 0 0 1px var(--acento-forte); }
  .comparacao .chip[aria-pressed='true']::before { content: '✓'; font-weight: 800; color: var(--acento-forte); margin-left: .3rem; }
  .comparacao .chip[aria-pressed='false'] { color: var(--tinta-suave); }
  .comparacao .chip[aria-pressed='false'] img { filter: grayscale(1); opacity: .6; }
  .comparacao .chip:hover { border-color: var(--azul-claro); }
  .comparacao .contagem { flex-basis: 100%; }

  .comparacao .filtro-busca { margin: 0 0 1rem; padding: .6rem .9rem; background: var(--realce); border: 1px solid var(--azul-claro); border-radius: var(--raio); }
  .comparacao .filtro-busca[hidden] { display: none; }
  .comparacao .filtro-busca p { margin: 0; font-size: .92rem; }
  .comparacao .filtro-busca .filtro-texto { font-weight: 600; }
  .comparacao .filtro-busca a { color: var(--acento); font-weight: 600; }
  .comparacao .filtro-busca .filtro-acoes { margin-top: .2rem; }

  .comparacao .quadro { margin: .4rem 0 0; }
  .comparacao .cabecalho-colunas { position: sticky; top: var(--faixa-altura); z-index: 10; overflow: hidden; background: var(--cartao);
    border: 1px solid var(--linha); border-bottom: 2px solid var(--linha-forte); border-radius: var(--raio) var(--raio) 0 0; }
  .comparacao .cabecalho-colunas .grade { padding: .55rem .5rem; }
  .comparacao .candidato[hidden] { display: none; }
  .comparacao .candidato { display: flex; align-items: center; gap: .55rem; min-width: 0; padding: .1rem .35rem; }
  .comparacao .candidato img { width: 36px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid var(--linha); background: var(--realce); flex: none; }
  .comparacao .candidato .nome { display: block; font-family: var(--fonte-titulo); font-weight: 750; font-size: .98rem; line-height: 1.15; letter-spacing: -.02em; color: var(--acento-forte); }
  .comparacao .candidato .ficha { display: block; font-size: .76rem; color: var(--tinta-suave); margin-top: .15rem; }

  .comparacao .rolagem { overflow-x: auto; -webkit-overflow-scrolling: touch; background: var(--cartao);
    border: 1px solid var(--linha); border-top: 0; border-radius: 0 0 var(--raio) var(--raio); }
