---
/**
 * Quem está na comparação de um escopo e por quê: o critério do corte (a
 * pesquisa, o mínimo de 1%, até seis candidatos), os retratos dos candidatos
 * comparados e quem ficou de fora com o motivo. Os dados vêm de
 * data/comparacao/criterio.json (v3/exporta_criterio.py) e dos candidatos da
 * própria comparação — nada escrito à mão por UF.
 */
import Candidatos from './Candidatos.astro';
import { criterioDoEscopo } from '../lib/criterio.mjs';

const { candidatos, cargo = 'presidente', uf = null } = Astro.props;
const c = criterioDoEscopo(cargo, uf);
const quantos = `${candidatos.length} ${candidatos.length === 1 ? 'candidato' : 'candidatos'}`;
// 16/09 (revisão jurídica §3.2): a pesquisa que decide o corte aparece com o número de
// registro no TSE e o período de campo como está no cadastro — sem os percentuais dela.
const diaMes = (iso) => (iso ? `${iso.slice(8, 10)}/${iso.slice(5, 7)}` : '');
const campoDoCadastro = c && c.campo_inicio && c.campo_fim ? `campo de ${diaMes(c.campo_inicio)} a ${diaMes(c.campo_fim)}` : '';
const pesquisa = c
  ? [c.instituto, c.registro ? `registro ${c.registro} no TSE` : '', campoDoCadastro].filter(Boolean).join(', ')
  : '';
const limite = c && cargo !== 'presidente' ? ` (no máximo ${c.corte})` : '';
const fora = c ? c.fora.map((f) => `${f.nome}, ${f.motivo}`).join('; ') : '';
---
{c && (
  <section class="bloco candidatos-comparados">
    <h2 id="comparados">Candidatos comparados</h2>
    <p class="criterio">
      {`Comparamos os programas dos ${quantos} mais bem colocados na pesquisa `}
      {c.fonte_url
        ? <a href={c.fonte_url} rel="noopener noreferrer" target="_blank">{pesquisa}</a>
        : pesquisa}
      {`, entre os que tinham pelo menos ${c.minimo_pct}% das intenções de voto${limite}. Candidaturas indeferidas pela Justiça Eleitoral e quem não registrou programa de governo não entram.`}
    </p>
    <Candidatos candidatos={candidatos} />
    {fora && <p class="fora">{`Ficaram de fora: ${fora}.`}</p>}
    {c.notas.map((nota) => <p class="fora">{nota}</p>)}
    <p class="fora"><a href="/metodologia">Como a comparação é feita</a></p>
  </section>
)}

<style>
  .candidatos-comparados .criterio { max-width: 60rem; }
  .candidatos-comparados .fora { color: var(--tinta-suave); font-size: .92rem; margin: .4rem 0; }
</style>
