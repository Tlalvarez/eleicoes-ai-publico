---
/**
 * A caixa de busca. Com JavaScript, a busca roda no navegador e leva à matriz
 * do tema com o melhor resultado, filtrada pelo assunto (`?q=`); sem
 * JavaScript, o formulário GET cai em /busca, que lista os resultados.
 * Usada na home, no hub e na própria página de tema.
 */
// `semRotulo` esconde o rótulo visual (a página já tem um título para a
// caixa, apontado em `rotuladoPor`); o campo continua rotulado para leitor de tela
const { escopo = 'presidente', compacta = false, semRotulo = false, rotuladoPor = null } = Astro.props;
const idCampo = `busca-q-${escopo.replace('/', '-')}`;
// os exemplos do campo são do escopo: gerados por v3/exemplos_busca.py a partir
// das propostas daquela UF e conferidos contra a própria busca
// (scripts/confere-exemplos-busca.mjs); sem o arquivo, exemplos gerais
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { RAIZ_PROJETO } from '../lib/comparacao-dados.mjs';
const arqExemplos = join(RAIZ_PROJETO, 'data', 'busca', escopo, 'exemplos.json');
const exemplos = existsSync(arqExemplos)
  ? JSON.parse(readFileSync(arqExemplos, 'utf8')).exemplos.slice(0, 4)
  : (escopo === 'presidente' ? ['creche', 'escala 6x1', 'dívida pública', 'Nordeste'] : ['escolas', 'hospitais', 'segurança']);
const placeholder = `Ex.: ${exemplos.join(', ')}`;
---
<form class={`busca-caixa${compacta ? ' compacta' : ''}${semRotulo ? ' sem-rotulo' : ''}`} action="/busca" method="get" role="search" data-escopo={escopo}>
  <label for={idCampo} class={semRotulo ? 'so-leitor' : undefined}>Buscar nos programas de governo</label>
  <div class="linha">
    <input class="campo" id={idCampo} name="q" type="search" maxlength="300" autocomplete="off" aria-labelledby={rotuladoPor ?? undefined}
      placeholder={placeholder} />
    {escopo !== 'presidente' && <input type="hidden" name="escopo" value={escopo} />}
    <button class="botao" type="submit">Buscar</button>
  </div>
  <p class="busca-estado" aria-live="polite"></p>
</form>

<script>
  import { buscaPorPagina, destinoDaBusca } from '../lib/busca-navegador.mjs';
  import { medir } from '../lib/medicao.mjs';

  for (const form of document.querySelectorAll('form.busca-caixa')) {
    const campo = form.querySelector('input[name="q"]');
    const estado = form.querySelector('.busca-estado');
    const escopo = form.dataset.escopo || 'presidente';
    // na página filtrada, a caixa mostra a consulta em vigor
    const params = new URLSearchParams(location.search);
    if (params.get('q') && !campo.value) campo.value = params.get('q');

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const q = campo.value.trim();
      if (!q) return;
      estado.textContent = 'Buscando…';
      let r;
      try {
        r = await buscaPorPagina(escopo, q);
      } catch {
        // sem índice, vale o caminho sem JavaScript: a página de resultados
        form.submit();
        return;
      }
      const destino = destinoDaBusca(escopo, q, r.porPagina, params.get('c') || '');
      if (!destino) {
        // a busca com resultado é medida na página de destino; a sem resultado, aqui
        medir('busca_feita', { consulta: q, resultados: 0, temas: 0, modo: r.modo, direto: false });
        estado.textContent = 'Nenhuma proposta fala disso. Tente outras palavras, ou navegue pelos temas.';
        return;
      }
      estado.textContent = r.porPagina.length > 1
        ? `${r.propostas.length} propostas em ${r.porPagina.length} temas; abrindo ${r.porPagina[0].nome}…`
        : `${r.propostas.length} propostas em ${r.porPagina[0].nome}; abrindo…`;
      location.assign(destino);
    });
  }
</script>

<style>
  .busca-caixa { margin: 1.2rem 0 1.6rem; max-width: 46rem; }
  .busca-caixa label { display: block; margin: 0 0 .35rem; font-size: .82rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--acento-forte); }
  .busca-caixa .linha { display: flex; gap: .5rem; }
  /* mesma forma dos vizinhos (16/09): na faixa da comparação, "Buscar nos programas" e os
     chips de candidato são pílulas de borda fina — campo e botão retangulares destoavam.
     Limitado à caixa de busca: .campo e .botao seguem como estão no resto do site. */
  .busca-caixa .campo { border-radius: 999px; padding-inline: 1rem; border-color: var(--linha-forte); }
  .busca-caixa .botao { border-radius: 999px; }
  .busca-caixa .campo { flex: 1 1 auto; min-width: 0; }
  .busca-caixa .botao { flex: none; }
  .busca-caixa .busca-estado { margin: .35rem 0 0; min-height: 1.2rem; font-size: .88rem; color: var(--tinta-suave); }
  .busca-caixa.compacta { margin: .6rem 0 1rem; }
  .busca-caixa.sem-rotulo { margin-top: .4rem; }
  .so-leitor { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 480px) {
    .busca-caixa .linha { flex-wrap: wrap; }
    .busca-caixa .botao { width: 100%; }
  }
</style>
