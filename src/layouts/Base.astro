        posthog.init('phc_DgFwkBNnfs9KNAYJ8jE6Ee2VQCVGc8AJyLDaWtXc5wqD', {
          api_host: 'https://us.i.posthog.com',
          defaults: '2026-05-30',
          capture_pageview: true,       // só carga real de página: o chat troca a URL com replaceState
          cookieless_mode: 'always',    // exige "Cookieless server hash mode" ligado no projeto
          person_profiles: 'never',     // eventos anônimos, nunca identify()
          disable_session_recording: true,
          disable_capture_url_hashes: true,        // sem fragmento: links antigos carregam a resposta inteira depois do #
          mask_personal_data_properties: true,     // mascara parâmetros pessoais nas URLs medidas...
          custom_personal_data_properties: ['q'],  // ...inclusive ?q= (a pergunta na URL)
        });
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site">
      <div class="inner">
        <a class="brand" href="/">eleicoes<span>.ai</span></a>
        <input type="checkbox" id="menu-aberto" class="menu-caixa" />
        <label for="menu-aberto" class="menu-botao">☰ Menu</label>
        <!-- o menu é POR CARGO (src/lib/cargos.mjs). As seções internas de
             candidato e de acervo continuam construídas, mas escondidas: sem
             entrada no menu e sem link a partir da home. -->
        <nav class="main" aria-label="Principal">
          {CARGOS.map((cargo) => (
            <a href={cargo.href} aria-current={atual(cargo.href)}>{cargo.nome}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="site">
      <div class="inner">
        <p><strong>Transparência:</strong> as respostas são geradas por inteligência artificial exclusivamente a partir das evidências recuperadas para cada pergunta.</p>
        <p><strong>Neutralidade:</strong> o eleicoes.ai não recomenda voto e não ranqueia candidatos.</p>
        <p><a href="/metodologia">Metodologia</a>: como filtramos e coletamos os dados</p>
        <p class="aviso-independencia">O eleicoes.ai é uma <strong>iniciativa independente</strong>, sem vínculo, patrocínio ou endosso da Justiça Eleitoral.</p>
      </div>
    </footer>
  </body>
</html>
