---
import '../styles/global.css';
import { CARGOS } from '../lib/cargos.mjs';
const {
  title,
  description = 'Converse com as evidências reunidas sobre os candidatos de 2026: cada resposta separa o que está registrado, o que é inferência e o que é lacuna, com link para a fonte original.',
} = Astro.props;
const path = Astro.url.pathname;
const atual = (p) => {
  // a home é a conversa sobre Presidente; a conversa de um candidato a
  // presidente (/presidente/<slug>) e a página de uma resposta guardada
  // (/resposta/<id>) são a mesma seção, então o mesmo item fica marcado
  if (p === '/') {
    return path === '/' || path === '/index.html' || path.startsWith('/presidente/')
      || path.startsWith('/resposta/') ? 'page' : undefined;
  }
  return (path === p || path.startsWith(p + '/') || path === p + '.html') ? 'page' : undefined;
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" /><!-- soft launch: remover no lançamento público -->
    <meta name="color-scheme" content="light dark" />
    <!-- ícone do site: o "e" de eleicoes sobre o azul-marinho, com a faixa da
         identidade. .ico para navegador antigo e robô, SVG para os atuais,
         PNG para a tela inicial do iPhone/iPad. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} · eleicoes.ai</title>
    <script is:inline>
      // Medição de audiência (PostHog), só no domínio publicado: dev, gates e
      // prévias *.pages.dev não carregam nada. Modo sem cookies: nada é gravado
      // no navegador, eventos anônimos, o campo de pergunta não é capturado.
      // Stub oficial do PostHog (Web analytics › Install › HTML snippet).
