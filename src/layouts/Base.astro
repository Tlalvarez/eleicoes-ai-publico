---
import '../styles/global.css';
import { CARGOS_NO_MENU } from '../lib/cargos.mjs';
const {
  title,
  description = 'Os programas de governo registrados no TSE pelos candidatos de 2026, comparados tema a tema: onde convergem, onde divergem e o que não tratam. Com o trecho de cada programa, sem recomendação de voto.',
  // Seções construídas mas fora do menu (hoje só a verificação,
  // verificação) ficam fora dos buscadores: o lançamento de 05/09/2026 tirou o
  // noindex do LAYOUT, e essas páginas não passaram pela revisão de superfície
  // pública (rótulos antigos, juízos de backtest, promessas datadas).
  noindex = false,
} = Astro.props;
const path = Astro.url.pathname;
// O build gera ARQUIVOS (`/sobre.html`), mas o endereço público é sem a
// extensão. O og:url é o destino que o WhatsApp e o X usam quando alguém
// compartilha, então ele tem de ser o endereço público — senão o link
// compartilhado vira `eleicoes.ai/sobre.html`.
const caminhoPublico = path.replace(/index\.html$/, '').replace(/\.html$/, '') || '/';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- prévia ao colar o link (WhatsApp, X, Slack): título, descrição e a
         imagem da marca. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="eleicoes.ai" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(caminhoPublico, Astro.site ?? 'https://eleicoes.ai').toString()} />
    <meta property="og:image" content={new URL('/og-eleicoes-programas.png', Astro.site ?? 'https://eleicoes.ai').toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="eleicoes.ai — Compare os programas de governo dos candidatos de 2026, tema a tema. Com o trecho de cada programa. Sem recomendação de voto." />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- lançamento público em 05/09/2026: sem noindex no layout. Só as seções
         fora do menu pedem `noindex` (prop). -->
    {noindex && <meta name="robots" content="noindex, follow" />}
    <!-- o endereço canônico é o sem `?c=`: o filtro de candidatos vive na URL, e
         sem isto cada combinação seria uma página a mais para o buscador. Página
         fora dos buscadores não declara canônico. -->
    {!noindex && <link rel="canonical" href={new URL(caminhoPublico, Astro.site ?? 'https://eleicoes.ai').toString()} />}
    <meta name="color-scheme" content="light dark" />
    <!-- ícone do site: o "e" de eleicoes sobre o azul-marinho, com a faixa da
         identidade. .ico para navegador antigo e robô, SVG para os atuais,
         PNG para a tela inicial do iPhone/iPad. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} · eleicoes.ai</title>
    <script is:inline>
      // Medição de audiência (PostHog), só no domínio publicado: dev, gates e
      // prévias *.pages.dev não carregam nada. Modo sem cookies: nada é gravado
      // no navegador, eventos anônimos.
      // Stub oficial do PostHog (Web analytics › Install › HTML snippet).
      if (location.hostname === 'eleicoes.ai') {
        !function(t,e){var o,n,p,r;e.__SV||(window.posthog && window.posthog.__loaded)||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}p||((p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",p.onerror=function(){p=null},(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r));var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagResult isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        posthog.init('phc_DgFwkBNnfs9KNAYJ8jE6Ee2VQCVGc8AJyLDaWtXc5wqD', {
          api_host: 'https://us.i.posthog.com',
          defaults: '2026-05-30',
          capture_pageview: true,       // só carga real de página
          cookieless_mode: 'always',    // exige "Cookieless server hash mode" ligado no projeto
          person_profiles: 'never',     // eventos anônimos, nunca identify()
          disable_session_recording: true,
          disable_capture_url_hashes: true,
          mask_personal_data_properties: true,     // mascara parâmetros pessoais nas URLs medidas
          // Só o vocabulário de medicao.mjs sai daqui. O autocapture do PostHog
          // mandava o TEXTO do elemento clicado (nome de candidato, texto de
          // proposta) — o que a privacidade diz que não vai. Desligado em 13/09,
          // com o resto que grava conteúdo da tela.
          autocapture: false,
          capture_dead_clicks: false,
          capture_heatmaps: false,
          enable_heatmaps: false,
          enable_recording_console_log: false,
          rageclick: false,
        });
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site">
      <div class="inner">
        <a class="brand" href="/">eleicoes<span>.ai</span></a>
        <!-- Os cargos (CARGOS_NO_MENU) e a metodologia. A home é a porta de
             Presidente, então Presidente leva a "/" e fica marcado na home e em
             /presidente/*; cada cargo por UF fica marcado em toda a sua seção.
             Metodologia entra ao lado deles por decisão do Thiago (16/09): quem
             lê a matriz e quer saber como ela foi feita não devia ter de descer
             até o rodapé. Ela NÃO é cargo, por isso vem fora da lista — e é por
             isso também que o menu deixou de se chamar "Cargos". -->
        <nav class="main" aria-label="Seções">
          {CARGOS_NO_MENU.map((c) => {
            const destino = c.porUF ? c.href : '/';
            const atual = c.porUF ? caminhoPublico.startsWith(c.href) : (caminhoPublico === '/' || caminhoPublico.startsWith(c.href));
            return <a href={destino} aria-current={atual ? 'page' : undefined}>{c.nome}</a>;
          })}
          <a href="/metodologia" aria-current={caminhoPublico.startsWith('/metodologia') ? 'page' : undefined}>Metodologia</a>
        </nav>
      </div>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="site">
      <div class="inner">
        <p><strong>Transparência:</strong> as propostas são lidas e agrupadas por inteligência artificial exclusivamente a partir dos programas de governo registrados no TSE.</p>
        <p><strong>Neutralidade:</strong> o eleicoes.ai não recomenda voto e não ranqueia candidatos.</p>
        <p><a href="/metodologia">Metodologia</a>: como os programas são lidos e comparados</p>
        <p><a href="/sobre">Quem somos</a> · <a href="/privacidade">Privacidade</a> · <a href="/correcoes">Correções</a></p>
        <p class="aviso-independencia">O eleicoes.ai é uma <strong>iniciativa independente</strong>, sem vínculo, patrocínio ou endosso da Justiça Eleitoral.</p>
      </div>
    </footer>
    <script>
      // A navegação é medida por DELEGAÇÃO: um ouvinte no documento, nenhuma
      // alteração nas páginas que desenham os cartões. Todo link medido declara
      // `data-evento` e as propriedades em `data-*`; o vocabulário fechado de
      // medicao.mjs decide o que passa (chave fora da lista do evento é
      // descartada — o próprio `evento` inclusive).
      import { contextoDoCaminho, defineContextoPadrao, medir } from '../lib/medicao.mjs';

      defineContextoPadrao(contextoDoCaminho(location.pathname));

      document.addEventListener('click', (ev) => {
        const alvo = ev.target instanceof Element ? ev.target.closest('a[data-evento], button[data-evento]') : null;
        if (!alvo) return;
        // `beacon`: todo link medido aqui navega, e o envio comum morre com a página.
        // Medido em 17/09 no PostHog: 155 passagens entre matrizes em 30 dias e 115 sem
        // evento — três em cada quatro. O sendBeacon sobrevive ao descarregamento.
        medir(alvo.dataset.evento, { ...alvo.dataset }, { beacon: true });
      });
    </script>
  </body>
</html>
